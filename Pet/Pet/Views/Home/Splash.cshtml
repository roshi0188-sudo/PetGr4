@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PETGr4 - Splash</title>
    <link rel="stylesheet" href="~/css/splash.css">
</head>
<body>
    <div class="background-animation"></div>

    <div class="floating-icons">
        <span style="left: 10%; animation-delay: 0s;">🐶</span>
        <span style="left: 30%; animation-delay: 2s;">🐱</span>
        <span style="left: 50%; animation-delay: 4s;">🐾</span>
        <span style="left: 70%; animation-delay: 1s;">🦴</span>
        <span style="left: 90%; animation-delay: 3s;">🐕</span>
        <span style="left: 20%; animation-delay: 5s;">🐩</span>
        <span style="left: 40%; animation-delay: 0.5s;">🐈</span>
        <span style="left: 60%; animation-delay: 2.5s;">🐕‍🦺</span>
        <span style="left: 80%; animation-delay: 1.5s;">🎾</span>
    </div>

    <div class="splash-container">
        <div class="logo-box">
            <img src="~/images/logo.jpg" alt="PETSocial Logo">
        </div>
        <h1>PETSocial</h1>
        <p>Social Network For Pet Lovers</p>
        <div class="loading">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>

    <script src="~/js/splash.js"></script>
</body>
</html>