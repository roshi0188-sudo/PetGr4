@model IEnumerable<PetSocial.Models.PetMatch>

@{
    ViewData["Title"] = "Lời mời kết nối";
    ViewData["ActiveMenu"] = "Requests";
    ViewData["FullWidth"] = true;

    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    string PetImage(PetSocial.Models.PetModule pet)
    {
        return string.IsNullOrWhiteSpace(pet.AvatarUrl)
            ? Url.Content("~/images/default-avatar.png")
            : Url.Content(pet.AvatarUrl);
    }

}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet"
      href="~/css/match-request.css" />

<section class="request-page">

    <div class="request-header">

        <span class="request-eyebrow">
            <i class="bi bi-envelope-heart-fill"></i>
            Pet Dating
        </span>

        <h1 class="text-request-title">
            Lời mời kết nối
        </h1>

        <p>
            Các thú cưng muốn làm quen với thú cưng của bạn.
        </p>

    </div>

    <div class="request-grid">

        @if (Model == null || !Model.Any())
        {
            <div class="empty-request-box">

                <i class="bi bi-mailbox"></i>

                <h2>
                    Chưa có lời mời nào
                </h2>

                <p>
                    Khi có lời mời kết nối mới chúng sẽ xuất hiện tại đây.
                </p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var isIncoming = item.ReceiverPet.UserId == currentUserId;

                <article class="request-card">

                    <div class="request-pet-pair">

                        <a asp-controller="Pet"
                           asp-action="Details"
                           asp-route-id="@item.SenderPetId"
                           class="request-pet-photo"
                           aria-label="Xem chi tiết @item.SenderPet.Name">

                            <img src="@PetImage(item.SenderPet)"
                                 alt="@item.SenderPet.Name" />

                            @if ((DateTime.Now - item.CreatedAt).TotalHours < 24)
                            {
                                <span class="request-new-badge">
                                    NEW
                                </span>
                            }

                            <span class="request-pet-label">
                                @item.SenderPet.Name
                            </span>
                        </a>

                        <div class="request-pair-heart">
                            <i class="bi bi-heart-fill"></i>
                        </div>

                        <a asp-controller="Pet"
                           asp-action="Details"
                           asp-route-id="@item.ReceiverPetId"
                           class="request-pet-photo"
                           aria-label="Xem chi tiết @item.ReceiverPet.Name">

                            <img src="@PetImage(item.ReceiverPet)"
                                 alt="@item.ReceiverPet.Name" />

                            <span class="request-pet-label">
                                @item.ReceiverPet.Name
                            </span>
                        </a>
                    </div>

                    <div class="request-card-body">

                        <p>
                            <strong>@item.SenderPet.Name</strong>
                            muốn kết nối với
                            <a asp-controller="Pet"
                               asp-action="Details"
                               asp-route-id="@item.ReceiverPetId">
                                @item.ReceiverPet.Name
                            </a>
                        </p>

                        <span class="request-time">
                            <i class="bi bi-clock"></i>
                            @item.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                        </span>

                        @if (isIncoming)
                        {
                            <div class="request-actions">

                                <a asp-action="Accept"
                                   asp-route-id="@item.Id"
                                   class="request-accept">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Đồng ý
                                </a>

                                <form asp-action="Cancel"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="request-decline"
                                            onclick="return confirm('Từ chối lời mời này?')">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Từ chối
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="request-actions request-actions-sent">
                                <span class="request-sent-status">
                                    <i class="bi bi-send-check-fill"></i>
                                    Đã gửi
                                </span>

                                <form asp-action="Cancel"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="request-decline"
                                            onclick="return confirm('Hủy lời mời đã gửi?')">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Hủy lời mời
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </article>
            }
        }

    </div>

</section>
