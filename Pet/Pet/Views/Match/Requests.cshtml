@model IEnumerable<PetSocial.Models.PetMatch>

@{
    ViewData["Title"] = "Lời mời kết nối";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/match-request.css" />

<div class="container mt-4 mb-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold text-request-title">
            <i class="bi bi-envelope-heart-fill me-2"></i>Lời mời kết nối
        </h2>
        <p class="text-muted">Danh sách các bé đang "thầm thương trộm nhớ" và gửi lời mời kết bạn đến thú cưng của bạn.</p>
    </div>

    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-request-box p-5 bg-white rounded-3 border">
                    <i class="bi bi-mailbox text-muted fs-1"></i>
                    <p class="text-muted mt-3 mb-0">Hộp thư trống! Hiện tại chưa có lời mời kết nối mới nào.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-6 col-md-12 mb-4">
                    <div class="card request-card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center flex-wrap flex-sm-nowrap">

                                <div class="request-avatar-wrapper position-relative mx-auto mx-sm-0 mb-3 mb-sm-0">
                                    <img src="@(string.IsNullOrEmpty(item.SenderPet.AvatarUrl) ? "/images/default-avatar.png" : item.SenderPet.AvatarUrl)"
                                         class="request-pet-img shadow-sm" alt="@item.SenderPet.Name" />
                                    <span class="position-absolute top-0 start-0 badge rounded-pill bg-orange font-size-11">New</span>
                                </div>

                                <div class="request-info ms-sm-4 flex-grow-1 text-center text-sm-start">
                                    <h5 class="fw-bold text-dark mb-1">
                                        @item.SenderPet.Name
                                    </h5>
                                    <div class="mb-2">
                                        <span class="badge bg-orange-light text-orange font-size-12">
                                            <i class="bi bi-tag-fill me-1"></i>@item.SenderPet.Breed
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-3 mb-sm-0">
                                        Muốn gửi tín hiệu kết nối đến bé <strong class="text-dark">@item.ReceiverPet.Name</strong> của bạn!
                                    </p>
                                </div>

                                <div class="request-actions d-flex flex-sm-column gap-2 w-100 w-sm-auto justify-content-center">

                                    <a asp-action="Accept"
                                       asp-route-id="@item.Id"
                                       class="btn btn-accept rounded-pill px-4 py-2 fw-bold text-nowrap">
                                        <i class="bi bi-check-lg me-1"></i> Đồng ý
                                    </a>

                                    <a asp-action="Decline"
                                       asp-route-id="@item.Id"
                                       class="btn btn-decline rounded-pill px-4 py-2 text-nowrap"
                                       onclick="return confirm('Bạn có chắc chắn muốn bỏ qua lời mời này không?')">
                                        Bỏ qua
                                    </a>

                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>