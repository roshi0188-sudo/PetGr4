@model IEnumerable<PetSocial.Models.PetModule>

<div class="container mt-4">

    <h2 class="mb-4">

        ❤️ Gợi ý cho @ViewBag.PetName

    </h2>

    <div class="row">

        @foreach (var pet in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow">

                    <img src="@pet.AvatarUrl"
                         class="card-img-top"
                         style="height:250px;object-fit:cover;" />

                    <div class="card-body">

                        <h4>@pet.Name</h4>

                        <p>
                            📍 @pet.Location
                        </p>

                        <p>
                            🐾 @pet.Breed
                        </p>

                        <p>
                            ❤️ @pet.Personality
                        </p>

                        <form asp-action="SendMatch"
                              method="post">

                            <input type="hidden"
                                   name="receiverPetId"
                                   value="@pet.Id" />

                            <button class="btn btn-danger w-100">

                                ❤️ Kết nối

                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>

</div>