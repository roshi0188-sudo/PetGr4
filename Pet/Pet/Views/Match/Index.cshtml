@using System.Collections.Generic
@using System.Linq
@model IEnumerable<PetSocial.Models.PetModule>

@{
    ViewData["Title"] = "Pet Dating";
    ViewData["ActiveMenu"] = "Dating";
    ViewData["FullWidth"] = true;

    var suggestions = Model?.ToList() ?? new List<PetSocial.Models.PetModule>();
    var myPets = ViewBag.MyPets as List<PetSocial.Models.PetModule> ?? new();
    var selectedMyPet = ViewBag.SelectedMyPet as PetSocial.Models.PetModule;
    var selectedCommunityPet = ViewBag.SelectedCommunityPet as PetSocial.Models.PetModule;
    var showSuggestions = ViewBag.ShowSuggestions as bool? ?? false;

    bool canSendRequest = ViewBag.CanSendRequest as bool? ?? true;

    string PetImage(PetSocial.Models.PetModule? pet)
    {
        return pet == null || string.IsNullOrWhiteSpace(pet.AvatarUrl)
            ? Url.Content("~/images/default-avatar.png")
            : Url.Content(pet.AvatarUrl);
    }
}

<section class="dating-page">
    <div class="dating-main">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                <i class="fa fa-check-circle"></i>
                @TempData["Success"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4">
                <i class="fa fa-exclamation-triangle"></i>
                @TempData["Error"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <div class="dating-heading">

            <div>
                <span class="dating-eyebrow">
                    <i class="fa fa-paper-plane"></i>
                    Pet Dating
                </span>

                <h1>Ghép đôi thú cưng</h1>

                <p>
                    Chọn thú cưng của bạn và thú cưng cộng đồng,
                    sau đó gửi lời mời kết nối.
                </p>
            </div>

            <div class="dating-heading-actions">

                <a asp-controller="Match"
                   asp-action="Requests"
                   class="dating-soft-button">

                    <i class="fa fa-bell"></i>

                    Lời mời

                    @if (ViewBag.PendingCount != null &&
                   (int)ViewBag.PendingCount > 0)
                    {
                        <span class="dating-badge">
                            @ViewBag.PendingCount
                        </span>
                    }

                </a>

                <a asp-controller="Match"
                   asp-action="Matches"
                   class="dating-soft-button dating-blue-button">

                    <i class="fa fa-users"></i>
                    Đã kết nối

                </a>

            </div>

        </div>

        <div class="dating-pet-strip">

            <div class="dating-strip-title">
                <strong>Thú cưng của tôi</strong>
                <span>@myPets.Count hồ sơ</span>
            </div>

            <div class="dating-my-pets">

                @if (myPets.Any())
                {
                    foreach (var pet in myPets)
                    {
                        <a asp-action="Index"
                           asp-route-communityPetId="@selectedCommunityPet?.Id"
                           asp-route-myPetId="@pet.Id"
                           class="dating-my-pet @(selectedMyPet?.Id == pet.Id ? "active" : "")">

                            <img src="@PetImage(pet)"
                                 alt="@pet.Name" />

                        </a>
                    }
                }
                else
                {
                    <a asp-controller="Pet"
                       asp-action="MyPets"
                       class="dating-add-pet">

                        <i class="fa fa-plus"></i>

                    </a>
                }

            </div>

        </div>

        <div class="dating-stage">
            <div class="dating-heart-rain" aria-hidden="true">
                <span style="--i: 0;"></span>
                <span style="--i: 1;"></span>
                <span style="--i: 2;"></span>
                <span style="--i: 3;"></span>
                <span style="--i: 4;"></span>
                <span style="--i: 5;"></span>
                <span style="--i: 6;"></span>
                <span style="--i: 7;"></span>
            </div>

            <article class="dating-profile dating-profile-left">

                @if (selectedCommunityPet == null)
                {
                    <a asp-action="Index"
                       asp-route-myPetId="@selectedMyPet?.Id"
                       asp-route-showSuggestions="true"
                       class="dating-photo-ring dating-empty-ring">

                        <i class="fa fa-plus"></i>

                    </a>

                    <div class="dating-info">
                        <span>Thú cưng cộng đồng</span>
                        <h2>Chưa chọn</h2>
                        <p>Nhấn dấu cộng để chọn thú cưng phù hợp.</p>
                    </div>
                }
                else
                {
                    <div class="dating-photo-ring">

                        <img src="@PetImage(selectedCommunityPet)"
                             alt="@selectedCommunityPet.Name" />

                    </div>

                    <div class="dating-info">

                        <span>Thú cưng cộng đồng</span>

                        <h2>@selectedCommunityPet.Name</h2>

                        <p>
                            <i class="fa fa-paw"></i>
                            @(string.IsNullOrWhiteSpace(selectedCommunityPet.Breed)
                                ? selectedCommunityPet.Species
                                : selectedCommunityPet.Breed)
                        </p>

                        <div class="dating-tags">

                            <span>@selectedCommunityPet.Age tuổi</span>

                            <span>
                                @(selectedCommunityPet.Gender ??
                                    "Chưa cập nhật")
                            </span>

                        </div>

                        @if (ViewBag.MatchStatus != null)
                        {
                            <div class="alert alert-warning mt-3 mb-0">
                                @ViewBag.MatchStatus
                            </div>
                        }

                    </div>
                }

            </article>

            <div class="dating-heart-panel">

                @if (selectedCommunityPet != null && selectedMyPet != null)
                {
                    if (canSendRequest)
                    {
                        <form asp-action="SendMatch" method="post">
                            @Html.AntiForgeryToken()
                            
                            <input type="hidden" name="senderPetId" value="@selectedMyPet.Id" />
                            <input type="hidden" name="receiverPetId" value="@selectedCommunityPet.Id" />

                            <button type="submit"
                                    class="dating-heart"
                                    title="Ghép đôi thú cưng"
                                    onclick="return confirm('Gửi lời moiwg kết nối!')">
                                <i class="fa fa-heart"></i>
                                <span class="dating-heart-spark dating-heart-spark-one"></span>
                                <span class="dating-heart-spark dating-heart-spark-two"></span>
                                <span class="dating-heart-spark dating-heart-spark-three"></span>
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="dating-heart dating-heart-disabled">
                            <i class="fa fa-lock"></i>
                        </div>
                    }
                }
                else
                {
                    <div class="dating-heart dating-heart-disabled" title="Chọn đủ 2 thú cưng để ghép đôi">
                        <i class="fa fa-heart"></i>
                        <span class="dating-heart-spark dating-heart-spark-one"></span>
                        <span class="dating-heart-spark dating-heart-spark-two"></span>
                        <span class="dating-heart-spark dating-heart-spark-three"></span>
                    </div>

                }

            </div>

            <article class="dating-profile dating-profile-right">

                @if (selectedMyPet == null)
                {
                    <div class="dating-photo-ring dating-empty-ring">

                        <i class="fa fa-plus"></i>

                    </div>

                    <div class="dating-info">

                        <span>Thú cưng của tôi</span>
                        <h2>Chưa chọn</h2>

                    </div>
                }
                else
                {
                    <div class="dating-photo-ring">

                        <img src="@PetImage(selectedMyPet)"
                             alt="@selectedMyPet.Name" />

                    </div>

                    <div class="dating-info">

                        <span>Thú cưng của tôi</span>

                        <h2>@selectedMyPet.Name</h2>

                        <p>
                            <i class="fa fa-paw"></i>
                            @(string.IsNullOrWhiteSpace(selectedMyPet.Breed)
                                ? selectedMyPet.Species
                                : selectedMyPet.Breed)
                        </p>

                        <div class="dating-tags">

                            <span>@selectedMyPet.Age tuổi</span>

                            <span>
                                @(selectedMyPet.Gender ??
                                    "Chưa cập nhật")
                            </span>

                        </div>

                    </div>
                }

            </article>

        </div>

        @if (selectedCommunityPet != null &&
       selectedMyPet != null)
        {
            <div class="dating-selected-panel">

                <div>

                    <span>Cặp ghép đã chọn</span>

                    <strong>
                        @selectedMyPet.Name
                        ❤️
                        @selectedCommunityPet.Name
                    </strong>

                    <p>
                        Gửi lời mời kết nối đến chủ thú cưng.
                    </p>

                </div>

            </div>
        }

        @if (showSuggestions &&
       selectedMyPet != null &&
       selectedCommunityPet == null)
        {
            <div class="dating-suggestions-head">

                <h2>Gợi ý thú cưng phù hợp</h2>

                <p>
                    Các thú cưng cùng loài với
                    @selectedMyPet.Name
                </p>

            </div>

            @if (suggestions.Any())
            {
                <div class="dating-suggestion-grid">

                    @foreach (var pet in suggestions)
                    {
                        <article class="dating-suggestion-card">

                            <img src="@PetImage(pet)"
                                 alt="@pet.Name" />

                            <div>

                                <h3>@pet.Name</h3>

                                <p>@pet.Species</p>

                                <span>@pet.Age tuổi</span>

                            </div>

                            <a asp-action="Index"
                               asp-route-myPetId="@selectedMyPet.Id"
                               asp-route-communityPetId="@pet.Id">

                                <i class="fa fa-plus"></i>

                            </a>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="dating-empty-suggestions">

                    <i class="fa fa-paw"></i>

                    <strong>
                        Chưa có thú cưng phù hợp
                    </strong>

                </div>
            }
        }

    </div>
</section>
