@model IEnumerable<PetSocial.Models.PetMatch>

@{
    ViewData["Title"] = "Kết nối thành công";
    ViewData["ActiveMenu"] = "Matches";
    ViewData["FullWidth"] = true;

    string currentUserId = ViewBag.CurrentUserId;

    string PetImage(PetSocial.Models.PetModule pet)
    {
        return string.IsNullOrWhiteSpace(pet.AvatarUrl)
            ? Url.Content("~/images/default-avatar.png")
            : Url.Content(pet.AvatarUrl);
    }
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet"
      href="~/css/match.css" />

<section class="matches-page">

    <div class="matches-header">

        <span class="matches-eyebrow">
            <i class="bi bi-heart-fill"></i>
            Pet Dating
        </span>

        <h1 class="text-match-title">
            Danh sách kết nối
        </h1>

        <p>
            Những thú cưng đã được cả hai chủ nuôi đồng ý kết nối.
        </p>

    </div>

    <div class="matches-grid">

        @if (Model == null || !Model.Any())
        {
            <div class="matches-empty">

                <i class="bi bi-heartbreak"></i>

                <h2>
                    Chưa có kết nối nào
                </h2>

                <p>
                    Hãy gửi lời mời kết nối đến các thú cưng khác.
                </p>

            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                bool isSenderMine =
                    item.SenderPet.UserId == currentUserId;

                var myPet =
                    isSenderMine
                    ? item.SenderPet
                    : item.ReceiverPet;

                var partnerPet =
                    isSenderMine
                    ? item.ReceiverPet
                    : item.SenderPet;

                var chatUserId =
                    partnerPet.UserId;

                <article class="match-card">

                    <div class="match-pets">

                        <a asp-controller="Pet"
                           asp-action="Details"
                           asp-route-id="@myPet.Id"
                           class="match-pet">
                            <img src="@PetImage(myPet)"
                                 class="match-pet-img"
                                 alt="@myPet.Name" />
                            <span>@myPet.Name</span>
                        </a>

                        <div class="match-heart">
                            <i class="bi bi-heart-fill"></i>
                        </div>

                        <a asp-controller="Pet"
                           asp-action="Details"
                           asp-route-id="@partnerPet.Id"
                           class="match-pet">
                            <img src="@PetImage(partnerPet)"
                                 class="match-pet-img"
                                 alt="@partnerPet.Name" />
                            <span>@partnerPet.Name</span>
                        </a>
                    </div>

                    <div class="match-info">

                        <h2>
                            @myPet.Name <span>❤</span> @partnerPet.Name
                        </h2>

                        <div class="match-status">
                            <i class="bi bi-check-circle-fill"></i>
                            Đã kết nối
                        </div>

                        <time>
                            <i class="bi bi-clock-history"></i>
                            @item.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                        </time>
                    </div>

                    <div class="match-actions">

                        <a asp-controller="Chat"
                           asp-action="Index"
                           asp-route-userId="@chatUserId"
                           class="match-chat">
                            <i class="bi bi-chat-dots-fill"></i>
                            Nhắn tin
                        </a>

                        <form asp-action="Cancel"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="match-cancel"
                                    onclick="return confirm('Hủy kết nối này?')">
                                <i class="bi bi-heartbreak-fill"></i>
                                Hủy kết nối
                            </button>
                        </form>
                    </div>
                </article>
            }
        }

    </div>

</section>
