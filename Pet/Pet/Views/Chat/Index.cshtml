@model IEnumerable<PetSocial.Models.Message>

@{
    ViewData["Title"] = "Tin nhắn";
    ViewData["FullWidth"] = true;
    ViewData["ActiveMenu"] = "Message";

    string currentUserId = ViewBag.CurrentUserId;
    var receiver = ViewBag.Receiver as PetSocial.Models.AppUser;
    var unreadCounts = ViewBag.UnreadCounts as Dictionary<string, int> ?? new();
    var lastMessages = ViewBag.LastMessages as Dictionary<string, string> ?? new();
    var lastMessageTimes = ViewBag.LastMessageTimes as Dictionary<string, DateTime> ?? new();

}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet"
      href="~/css/chat.css" />

<div class="zalo-messenger-container">

    <!-- SIDEBAR -->

    <div class="zalo-sidebar">

        <div class="zalo-sidebar-header">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    Tin nhắn
                </h5>

                <button class="btn btn-light btn-sm rounded-circle">
                    <i class="bi bi-pencil-square"></i>
                </button>

            </div>

            <div class="mt-3">

                <input type="text"
                       id="searchUser"
                       class="form-control"
                       placeholder="Tìm kiếm bạn bè..." />

            </div>

        </div>

        <div class="zalo-chat-list"
             id="chatUserList">

            @foreach (var user in ViewBag.ChatUsers)
            {
                bool isActive =
                    receiver != null &&
                    receiver.Id == user.Id;

                string chatUserId = user.Id;
                int count = 0;
                string? message = user.Email;
                DateTime messageTime = DateTime.MinValue;

                int unreadCount =
                    unreadCounts.TryGetValue(chatUserId, out count)
                    ? count
                    : 0;

                string lastMessage =
                    lastMessages.TryGetValue(chatUserId, out message)
                    ? message ?? ""
                    : user.Email ?? "";

                DateTime? lastMessageTime =
                    lastMessageTimes.TryGetValue(chatUserId, out messageTime)
                    ? messageTime
                    : null;

                <a asp-controller="Chat"
                   asp-action="Index"
                   asp-route-userId="@user.Id"
                   data-user-id="@user.Id"
                   class="zalo-chat-item @(isActive ? "active-chat" : "") @(unreadCount > 0 ? "has-unread" : "")">

                    <div class="position-relative">

                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                        {
                            <img src="@user.AvatarUrl"
                                 class="zalo-avatar" />
                        }
                        else
                        {
                            <div class="zalo-avatar-letter">
                                @(string.IsNullOrEmpty(user.FullName)
                                    ? "U"
                                    : user.FullName.Substring(0, 1).ToUpper())
                            </div>
                        }

                        <span class="online-dot"></span>

                    </div>

                    <div class="zalo-item-body">

                        <div class="zalo-item-top">
                            <span class="zalo-item-name">
                                @user.FullName
                            </span>

                            @if (lastMessageTime.HasValue)
                            {
                                <time class="zalo-item-time">
                                    @lastMessageTime.Value.ToString("HH:mm")
                                </time>
                            }
                        </div>

                        <div class="zalo-item-bottom">
                            <span class="zalo-item-lastmsg">
                                @lastMessage
                            </span>

                            <span class="zalo-unread-dot"
                                  aria-label="Tin nhắn mới"></span>
                        </div>

                    </div>

                </a>
            }

        </div>

    </div>

    <!-- CHAT CONTENT -->

    <div class="zalo-content">

        @if (receiver != null)
        {
            <!-- HEADER -->

            <div class="zalo-chat-header">

                <div class="d-flex align-items-center">

                    @if (!string.IsNullOrEmpty(receiver.AvatarUrl))
                    {
                        <img src="@receiver.AvatarUrl"
                             class="zalo-avatar" />
                    }
                    else
                    {
                        <div class="zalo-avatar-letter">
                            @(string.IsNullOrEmpty(receiver.FullName)
                                ? "U"
                                : receiver.FullName.Substring(0, 1).ToUpper())
                        </div>
                    }

                    <div class="ms-3">

                        <h6 class="fw-bold mb-0">
                            @receiver.FullName
                        </h6>

                        <small class="text-success">
                            ● Đang hoạt động
                        </small>

                    </div>

                </div>

            </div>

            <!-- BODY -->

            <div id="chatBox"
                 class="zalo-chat-body">

                @foreach (var msg in Model)
                {
                    bool isMine =
                        msg.SenderId == currentUserId;

                    <div class="zalo-msg-row @(isMine ? "msg-mine" : "msg-other")">

                        @if (!isMine)
                        {
                            @if (!string.IsNullOrEmpty(receiver.AvatarUrl))
                            {
                                <img src="@receiver.AvatarUrl"
                                     class="zalo-avatar-mini me-2" />
                            }
                            else
                            {
                                <div class="zalo-avatar-letter mini me-2">
                                    @(receiver.FullName.Substring(0, 1).ToUpper())
                                </div>
                            }
                        }

                        <div class="zalo-msg-bubble">

                            <div class="msg-text">
                                @msg.Content
                            </div>

                            <small class="msg-time">
                                @msg.CreatedAt.ToString("HH:mm")
                            </small>

                        </div>

                    </div>
                }

            </div>

            <!-- FOOTER -->

            <div class="zalo-chat-footer">

                <input type="hidden"
                       id="receiverId"
                       value="@receiver.Id" />

                <div class="input-group">

                    <input type="text"
                           id="messageInput"
                           class="form-control"
                           placeholder="Nhập tin nhắn..." />

                    <button class="btn btn-primary"
                            onclick="sendMessage()">

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>

            </div>
        }
        else
        {
            <div class="zalo-empty-chat">

                <i class="bi bi-chat-dots"
                   style="font-size:90px;"></i>

                <h3 class="mt-3">
                    Chào mừng đến với Chat
                </h3>

                <p class="text-muted">
                    Hãy chọn một cuộc trò chuyện ở bên trái
                </p>

            </div>
        }

    </div>

</div>

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>

        const currentUserId = "@currentUserId";

        const receiverId =
        document.getElementById("receiverId")
        ?.value;

        const connection =
        new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

        connection.on(
        "ReceiveMessage",
        function(senderId, senderName, content, time)
        {
        const chatItem =
        senderId === currentUserId
        ? document.querySelector(".zalo-chat-item.active-chat")
        : document.querySelector(
        `.zalo-chat-item[data-user-id="${senderId}"]`);

        if(chatItem)
        {
        const preview =
        chatItem.querySelector(".zalo-item-lastmsg");

        const previewTime =
        chatItem.querySelector(".zalo-item-time");

        if(preview)
        preview.textContent = content;

        if(previewTime)
        previewTime.textContent = time;
        }

        if(senderId !== currentUserId &&
        senderId !== receiverId)
        {
        chatItem?.classList.add("has-unread");
        return;
        }

        const chatBox =
        document.getElementById("chatBox");

        if(!chatBox)
        return;

        const isMine =
        senderId === currentUserId;

        const cssClass =
        isMine
        ? "msg-mine"
        : "msg-other";

        chatBox.innerHTML +=
        `
        <div class="zalo-msg-row ${cssClass}">
        <div class="zalo-msg-bubble">
        <div>${content}</div>
        <small class="msg-time">
        ${time}
        </small>
        </div>
        </div>
        `;

        chatBox.scrollTop =
        chatBox.scrollHeight;
        });

        connection.start()
        .catch(err =>
        console.error(err.toString()));

        function sendMessage()
        {
        const content =
        document.getElementById("messageInput").value;

        if(content.trim() === "")
        return;

        connection.invoke(
        "SendMessage",
        receiverId,
        content);

        document.getElementById(
        "messageInput").value = "";
        }

        document.getElementById("messageInput")
        ?.addEventListener(
        "keypress",
        function(e)
        {
        if(e.key === "Enter")
        {
        sendMessage();
        }
        });

        document.getElementById("searchUser")
        ?.addEventListener(
        "keyup",
        function()
        {
        const keyword =
        this.value.toLowerCase();

        document
        .querySelectorAll(".zalo-chat-item")
        .forEach(item =>
        {
        const text =
        item.innerText.toLowerCase();

        item.style.display =
        text.includes(keyword)
        ? "flex"
        : "none";
        });
        });

        window.onload = function()
        {
        const chatBox =
        document.getElementById("chatBox");

        if(chatBox)
        {
        chatBox.scrollTop =
        chatBox.scrollHeight;
        }
        };

    </script>

}
