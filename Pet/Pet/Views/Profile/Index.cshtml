@model PetSocial.Models.AppUser
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    bool isAdmin = User.IsInRole("Admin");
}

<!-- Đồng bộ font chữ hệ thống Plus Jakarta Sans và Material Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<script>
    tailwind.config = {
    darkMode: "class",
    theme: {
    extend: {
    colors: {
    'pet-primary': '#FF6B00',
    'pet-primary-hover': '#E55A00',
    'pet-primary-fixed': '#FFF0E5',
    'pet-dark': '#151C27',
    'pet-background': '#F8FAFC'
    }
    }
    }
    }
</script>

<style>
    body {
    background-color: #F8FAFC;
    font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .ambient-shadow {
    box-shadow: 0 10px 30px rgba(21, 28, 39, 0.03);
    }
</style>

<main class="max-w-2xl mx-auto px-4 py-8">

    <!-- Thanh thông báo thông minh từ TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center gap-3 p-4 mb-5 text-sm text-emerald-800 rounded-2xl bg-emerald-50 border border-emerald-100 shadow-sm" role="alert">
            <span class="material-symbols-outlined text-emerald-600 font-bold">check_circle</span>
            <div class="font-semibold">@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Tiêu đề trang -->
    <div class="flex items-center gap-3 mb-6">
        <a asp-controller="Post" asp-action="Index" class="hover:bg-gray-100 p-2 rounded-full active:scale-95 duration-150 flex items-center justify-center transition-all" title="Quay lại bảng tin">
            <span class="material-symbols-outlined text-gray-700 text-xl font-bold">arrow_back</span>
        </a>
        <h2 class="profile-index-title text-xl font-extrabold text-gray-900 tracking-tight">Hồ sơ cá nhân</h2>
    </div>

    <!-- Thẻ thông tin tài khoản -->
    <div class="bg-white rounded-[24px] border border-gray-100 ambient-shadow p-8 text-center relative overflow-hidden">

        <!-- Khối trang trí background mờ góc trên -->
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-pet-primary to-orange-400"></div>

        <!-- Cụm hiển thị ảnh đại diện Avatar -->
        <div class="flex justify-center mb-5">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <div class="w-32 h-32 rounded-full ring-4 ring-pet-primary-fixed overflow-hidden bg-gray-50 flex items-center justify-center shadow-md">
                    <img src="@Model.AvatarUrl" alt="Avatar" class="w-32 h-32 object-cover" />
                </div>
            }
            else
            {
                <div class="w-32 h-32 rounded-full ring-4 ring-pet-primary-fixed overflow-hidden bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center shadow-md">
                    <span class="text-pet-primary font-black text-4xl">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                    </span>
                </div>
            }
        </div>

        <!-- Tên người dùng + Huy hiệu quyền hạn -->
        <div class="flex items-center justify-center gap-2 mb-1">
            <h3 class="text-2xl font-black text-gray-900">@Model.FullName</h3>
            @if (isAdmin)
            {
                <span class="bg-slate-900 text-amber-400 text-[10px] font-black px-2 py-0.5 rounded-md flex items-center gap-1 shadow-sm">
                    <span class="material-symbols-outlined text-[12px] fill-amber-400">shield</span>ADMIN
                </span>
            }
        </div>

        <!-- Phân tách thông tin dạng lưới tinh tế -->
        <div class="max-w-md mx-auto grid grid-cols-1 gap-3 my-6 p-4 rounded-2xl bg-gray-50/70 border border-gray-100/50 text-left">
            <div class="flex items-center gap-3 text-gray-600">
                <span class="material-symbols-outlined text-gray-400 text-lg">mail</span>
                <span class="text-sm font-medium"><span class="text-gray-400">Email:</span> @Model.Email</span>
            </div>
            <div class="flex items-center gap-3 text-gray-600">
                <span class="material-symbols-outlined text-gray-400 text-lg">call</span>
                <span class="text-sm font-medium"><span class="text-gray-400">Số điện thoại:</span> @(Model.PhoneNumber ?? "Chưa cập nhật")</span>
            </div>
            <div class="flex items-center gap-3 text-gray-600">
                <span class="material-symbols-outlined text-gray-400 text-lg">calendar_month</span>
                <span class="text-sm font-medium"><span class="text-gray-400">Ngày tham gia:</span> @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        <!-- Khối nút hành động phong cách viên thuốc -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <a asp-action="Edit" class="inline-flex items-center gap-2 bg-pet-primary hover:bg-pet-primary-hover text-white font-bold text-sm px-6 py-3 rounded-full transition-all shadow-sm active:scale-95 duration-100">
                <span class="material-symbols-outlined text-base">edit</span> Chỉnh sửa hồ sơ
            </a>

            <a asp-controller="Post" asp-action="Index" class="inline-flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm px-6 py-3 rounded-full transition-all active:scale-95 duration-100">
                <span class="material-symbols-outlined text-base">home</span> Quay lại bảng tin
            </a>
        </div>

    </div>
</main>
