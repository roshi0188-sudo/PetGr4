@model PetSocial.Models.AppUser
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var isOwnProfile = ViewBag.IsOwnProfile as bool? ?? true;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body text-center p-5">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle mb-3 object-fit-cover" style="width: 150px; height: 150px; border: 3px solid #0d6efd;" />
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=random" alt="Default Avatar" class="rounded-circle mb-3" style="width: 150px; height: 150px;" />
                    }

                    <h3 class="fw-bold">@Model.FullName</h3>
                    <p class="text-muted mb-1">Email: @Model.Email</p>
                    <p class="text-muted mb-4">Số điện thoại: @(Model.PhoneNumber ?? "Chưa cập nhật")</p>
                    <p class="text-muted mb-4">Tham gia từ: @Model.CreatedAt.ToString("dd/MM/yyyy")</p>

                    <div class="d-flex justify-content-center gap-2">
                        @if (isOwnProfile)
                        {
                            <a asp-action="Edit" class="btn btn-primary px-4">Chỉnh sửa hồ sơ</a>
                        }
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
