@model PetSocial.ViewModels.UserProfileVM
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<script>
    tailwind.config = {
    darkMode: "class",
    theme: {
    extend: {
    colors: {
    'pet-primary': '#FF6B00',         /* Tone cam PetSocial đồng bộ */
    'pet-primary-hover': '#E55A00',
    'pet-primary-fixed': '#FFF0E5',
    'pet-dark': '#151C27',
    'pet-background': '#F8FAFC'
    }
    }
    }
    }
</script>

<style>
    body {
    background-color: #F8FAFC;
    font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .ambient-shadow {
    box-shadow: 0 10px 30px rgba(21, 28, 39, 0.03);
    }

    /* Tối ưu hiệu ứng focus cho input */
    .pet-input:focus {
    border-color: var(--pet-primary) !important;
    --tw-ring-color: var(--pet-primary) !important;
    }
</style>

<main class="max-w-2xl mx-auto px-4 py-8">

    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="hover:bg-gray-100 p-2 rounded-full active:scale-95 duration-150 flex items-center justify-center transition-all" title="Quay lại hồ sơ">
            <span class="material-symbols-outlined text-gray-700 text-xl font-bold">arrow_back</span>
        </a>
        <h2 class="text-xl font-extrabold text-gray-900 tracking-tight">Cập nhật thông tin</h2>
    </div>

    <div class="bg-white rounded-[24px] border border-gray-100 ambient-shadow p-6 sm:p-8 relative overflow-hidden">

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 p-3 rounded-xl mb-4 font-medium"></div>

            <div class="flex flex-col items-center justify-center space-y-3 pb-4 border-b border-gray-100">
                <div class="relative group cursor-pointer" onclick="document.getElementById('avatarFileInput').click();">
                    @if (!string.IsNullOrEmpty(Model.CurrentAvatarUrl))
                    {
                        <div class="w-28 h-28 rounded-full ring-4 ring-pet-primary-fixed overflow-hidden bg-gray-50 flex items-center justify-center shadow-md">
                            <img src="@Model.CurrentAvatarUrl" alt="Current Avatar" id="avatarPreview" class="w-28 h-28 object-cover transition-opacity group-hover:opacity-80" />
                        </div>
                    }
                    else
                    {
                        <div class="w-28 h-28 rounded-full ring-4 ring-pet-primary-fixed overflow-hidden bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center shadow-md transition-opacity group-hover:opacity-80">
                            <span class="text-pet-primary font-black text-3xl" id="avatarTextPreview">
                                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                            </span>
                        </div>
                    }
                    <div class="absolute inset-0 bg-black/30 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                        <span class="material-symbols-outlined text-white text-2xl font-bold">photo_camera</span>
                    </div>
                </div>

                <div class="text-center">
                    <button type="button" onclick="document.getElementById('avatarFileInput').click();" class="text-xs font-bold text-pet-primary hover:text-pet-primary-hover transition-colors">
                        Thay đổi ảnh đại diện
                    </button>
                    <p class="text-[11px] text-gray-400 mt-0.5">Hỗ trợ định dạng .jpg, .jpeg, .png</p>
                </div>

                <input asp-for="AvatarFile" type="file" id="avatarFileInput" class="hidden" accept="image/*" onchange="previewImage(this);" />
            </div>

            <div class="space-y-1.5">
                <label asp-for="FullName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">Họ và tên</label>
                <div class="relative rounded-xl shadow-sm">
                    <input asp-for="FullName" class="pet-input block w-full border-gray-200 rounded-xl bg-gray-50/50 text-sm font-semibold text-gray-800 focus:border-pet-primary focus:ring-pet-primary" placeholder="Nhập họ và tên đầy đủ..." />
                </div>
                <span asp-validation-for="FullName" class="text-xs font-medium text-rose-600 block mt-1"></span>
            </div>

            <div class="space-y-1.5 opacity-70">
                <label asp-for="Email" class="block text-xs font-bold text-gray-400 uppercase tracking-wider">Địa chỉ Email</label>
                <div class="relative rounded-xl shadow-sm">
                    <input asp-for="Email" class="block w-full border-gray-200 rounded-xl bg-gray-100 text-sm font-semibold text-gray-400 cursor-not-allowed" disabled />
                </div>
                <p class="text-[11px] text-gray-400 font-medium">Tài khoản email dùng để đăng nhập và bảo mật nên không thể thay đổi.</p>
            </div>

            <div class="space-y-1.5">
                <label asp-for="PhoneNumber" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">Số điện thoại</label>
                <div class="relative rounded-xl shadow-sm">
                    <input asp-for="PhoneNumber" class="pet-input block w-full border-gray-200 rounded-xl bg-gray-50/50 text-sm font-semibold text-gray-800 focus:border-pet-primary focus:ring-pet-primary" placeholder="Nhập số điện thoại liên hệ..." />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-xs font-medium text-rose-600 block mt-1"></span>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <a asp-action="Index" class="inline-flex items-center gap-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs px-5 py-3 rounded-full transition-all active:scale-95 duration-100">
                    Hủy bỏ
                </a>
                <button type="submit" class="inline-flex items-center gap-1.5 bg-pet-primary hover:bg-pet-primary-hover text-white font-bold text-xs px-6 py-3 rounded-full transition-all shadow-sm active:scale-95 duration-100">
                    <span class="material-symbols-outlined text-sm font-bold">save</span> Lưu thay đổi
                </button>
            </div>
        </form>

    </div>
</main>

<script>
    function previewImage(input) {
    if (input.files && input.files[0]) {
    var reader = new FileReader();
    reader.onload = function (e) {
    var preview = document.getElementById('avatarPreview');
    if (preview) {
    preview.src = e.target.result;
    } else {
    // Nếu trước đó dùng text avatar, đổi khối thành ảnh
    var textPreview = document.getElementById('avatarTextPreview');
    if (textPreview) {
    var parent = textPreview.parentElement;
    parent.innerHTML = '<img src="' + e.target.result + '" id="avatarPreview" class="w-28 h-28 object-cover" />';
    }
    }
    }
    reader.readAsDataURL(input.files[0]);
    }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}