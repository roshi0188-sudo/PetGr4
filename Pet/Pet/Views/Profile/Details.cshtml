@model PetSocial.ViewModels.ProfileDetails

@{
    ViewData["Title"] = $"Hồ sơ của {Model.User.FullName}";
    ViewData["FullWidth"] = true;
    ViewData["ActiveMenu"] = Model.IsOwnProfile ? "Profile" : null;

    var isAdmin = User.IsInRole("Admin");
    var avatarUrl = string.IsNullOrWhiteSpace(Model.User.AvatarUrl) ? null : Url.Content(Model.User.AvatarUrl);
    var displayName = string.IsNullOrWhiteSpace(Model.User.FullName) ? Model.User.UserName ?? "Người dùng PetSocial" : Model.User.FullName;
    var email = string.IsNullOrWhiteSpace(Model.User.Email) ? "Chưa cập nhật email" : Model.User.Email;
    var phone = string.IsNullOrWhiteSpace(Model.User.PhoneNumber) ? "Chưa cập nhật số điện thoại" : Model.User.PhoneNumber;
}

@if (User.Identity?.IsAuthenticated == true)
{
    @Html.AntiForgeryToken()
}

<section class="profile-page">
    <div class="profile-main">
        <div class="profile-topbar">
            <a asp-controller="Post" asp-action="Index" class="profile-back-button" aria-label="Quay lại bảng tin">
                <i class="fa fa-arrow-left"></i>
            </a>
            <div>
                <h1>@(Model.IsOwnProfile ? "Trang cá nhân" : "Hồ sơ người dùng")</h1>
                <p>@(Model.IsOwnProfile ? "Bài viết và thông tin tài khoản của bạn." : "Xem bài viết và trao đổi với người đăng.")</p>
            </div>
        </div>

        <section class="profile-hero">
            <div class="profile-cover"></div>

            <div class="profile-identity">
                <div class="profile-avatar">
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="Ảnh đại diện của @displayName" />
                    }
                    else
                    {
                        <span>@displayName.Substring(0, 1).ToUpper()</span>
                    }
                </div>

                <div class="profile-title-block">
                    <div class="profile-name-line">
                        <h2>@displayName</h2>
                        @if (Model.User.Email == "admin@petsocial.com")
                        {
                            <span class="profile-admin-badge"><i class="fa fa-shield"></i> Admin</span>
                        }
                    </div>
                    <p><i class="fa fa-calendar"></i> Thành viên từ @Model.User.CreatedAt.ToString("dd/MM/yyyy")</p>
                </div>

                <div class="profile-actions">
                    @if (Model.IsOwnProfile)
                    {
                        <a asp-controller="Pet" asp-action="MyPets" class="profile-primary-action">
                            <i class="fa fa-paw"></i>
                            Xem thú cưng của tôi
                        </a>
                        <a asp-controller="Match" asp-action="Matches" class="profile-connect-list-action">
                            <i class="fa fa-users"></i>
                            Danh sách kết nối
                        </a>
                        <a asp-controller="Profile" asp-action="Edit" class="profile-secondary-action">
                            <i class="fa fa-pencil"></i>
                            Chỉnh sửa
                        </a>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Chat" asp-action="Index" asp-route-userId="@Model.User.Id" class="profile-primary-action">
                            <i class="fa fa-comments"></i>
                            Nhắn tin
                        </a>
                        <button type="button"
                                id="profileFollowBtn"
                                data-user-id="@Model.User.Id"
                                class="profile-follow-button @(Model.IsFollowing ? "is-following" : "")">
                            @(Model.IsFollowing ? "Đang theo dõi" : "Theo dõi")
                        </button>

                        @if (isAdmin)
                        {
                            <form asp-area="Admin" asp-controller="User" asp-action="ToggleBlock" asp-route-id="@Model.User.Id" method="post" class="profile-admin-form">
                                <button type="submit" class="profile-danger-action" title="Khóa/Mở khóa tài khoản">
                                    <i class="fa fa-ban"></i>
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="profile-primary-action">
                            <i class="fa fa-user-plus"></i>
                            Theo dõi
                        </a>
                    }
                </div>
            </div>

            <div class="profile-meta-grid">
                <div class="profile-meta-item">
                    <i class="fa fa-envelope"></i>
                    <span>Email</span>
                    <strong>@email</strong>
                </div>
                <div class="profile-meta-item">
                    <i class="fa fa-phone"></i>
                    <span>Điện thoại</span>
                    <strong>@phone</strong>
                </div>
                <div class="profile-meta-item">
                    <i class="fa fa-paw"></i>
                    <span>Thú cưng</span>
                    @if (Model.IsOwnProfile)
                    {
                        <a asp-controller="Pet" asp-action="MyPets">@Model.Pets.Count hồ sơ</a>
                    }
                    else
                    {
                        <strong>@Model.Pets.Count hồ sơ</strong>
                    }
                </div>
            </div>

            <div class="profile-stats">
                <div>
                    <strong>@Model.PostCount</strong>
                    <span>Bài viết</span>
                </div>
                <a asp-action="Followers" asp-route-id="@Model.User.Id">
                    <strong id="followerCountLabel">@Model.FollowerCount</strong>
                    <span>Người theo dõi</span>
                </a>
                <a asp-action="FollowingList" asp-route-id="@Model.User.Id">
                    <strong>@Model.FollowingCount</strong>
                    <span>Đang theo dõi</span>
                </a>
            </div>
        </section>

        <section class="profile-feed">
            <div class="profile-section-heading">
                <div>
                    <h2>Bài viết đã đăng</h2>
                    <p>Những chia sẻ gần đây của @displayName.</p>
                </div>
                <span>@Model.PostCount bài viết</span>
            </div>

            @if (!Model.Posts.Any())
            {
                <div class="profile-empty-posts">
                    <div><i class="fa fa-file-text-o"></i></div>
                    <h3>Chưa có bài viết nào</h3>
                    <p>Tài khoản này chưa chia sẻ bài viết lên PetSocial.</p>
                </div>
            }
            else
            {
                <div class="profile-post-list">
                    @foreach (var post in Model.Posts)
                    {
                        var totalLikesCount = post.Likes?.Count ?? 0;
                        var totalCommentsCount = post.Comments?.Count ?? 0;

                        <article class="profile-post-card">
                            <div class="profile-post-header">
                                <div class="profile-post-author">
                                    <div class="profile-post-avatar">
                                        @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="Ảnh đại diện của @displayName" />
                                        }
                                        else
                                        {
                                            <span>@displayName.Substring(0, 1).ToUpper()</span>
                                        }
                                    </div>
                                    <div>
                                        <strong>@displayName</strong>
                                        <span>@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>

                                @if (isAdmin)
                                {
                                    <form asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="profile-post-delete" title="Xóa bài viết">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>

                            <p class="profile-post-content">@post.Content</p>

                            @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                            {
                                <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="profile-post-image">
                                    <img src="@post.ImageUrl" alt="Hình ảnh bài đăng" loading="lazy" />
                                </a>
                            }

                            <div class="profile-post-footer">
                                <span><i class="fa fa-heart"></i> @totalLikesCount lượt thích</span>
                                <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">
                                    <i class="fa fa-comment"></i> @totalCommentsCount bình luận
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const profileFollowBtn = document.getElementById('profileFollowBtn');
            if (!profileFollowBtn) return;

            profileFollowBtn.addEventListener('click', function () {
                const targetUserId = profileFollowBtn.getAttribute('data-user-id');
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                const form = new URLSearchParams();
                form.append('targetUserId', targetUserId);

                fetch('/Post/ToggleFollow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: form.toString()
                })
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.success) {
                            profileFollowBtn.innerText = data.isFollowing ? 'Đang theo dõi' : 'Theo dõi';
                            profileFollowBtn.classList.toggle('is-following', data.isFollowing);

                            const followerCountLabel = document.getElementById('followerCountLabel');
                            if (followerCountLabel && data.followerCount !== undefined) {
                                followerCountLabel.innerText = data.followerCount;
                            }
                        } else if (data && data.message) {
                            alert(data.message);
                        }
                    })
                    .catch(err => console.error('Follow error', err));
            });
        })();
    </script>
}
