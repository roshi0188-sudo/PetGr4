@model List<PetSocial.Models.AppUser>
@{
    var profileUser = ViewData["ProfileUser"] as PetSocial.Models.AppUser;
    var listTitle = ViewData["ListTitle"] as string ?? "Danh sách";
    ViewData["Title"] = listTitle;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1" rel="stylesheet" />

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
    darkMode: "class",
    theme: {
    extend: {
    colors: {
    'pet-primary': '#944a18',
    'pet-primary-fixed': '#ffdbc9',
    'pet-secondary': '#356668',
    'pet-secondary-container': '#b9ecee',
    'pet-background': '#fbf9f8',
    'pet-surface-variant': '#e4e2e2'
    }
    }
    }
    }
</script>

<style>
    body {
    background-color: #fbf9f8;
    font-family: 'Quicksand', sans-serif;
    }

    .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    font-family: 'Material Symbols Outlined';
    display: inline-block;
    vertical-align: middle;
    line-height: 1;
    }

    .ambient-shadow {
    box-shadow: 0 4px 20px rgba(148, 74, 24, 0.05);
    }
</style>

<main class="max-w-xl mx-auto px-4 py-8">

    <div class="flex items-center gap-2 mb-6">
        <a asp-controller="Profile" asp-action="Details" asp-route-id="@(profileUser?.Id)" class="hover:bg-gray-200/70 transition-colors p-2 rounded-full active:scale-95 duration-150 flex items-center justify-center" title="Quay lại hồ sơ">
            <span class="material-symbols-outlined text-gray-700 text-xl font-bold">arrow_back</span>
        </a>
        <h2 class="text-xl font-bold text-gray-800 font-['Plus_Jakarta_Sans'] tracking-tight">
            @listTitle @(profileUser != null ? $"của {profileUser.FullName}" : "")
        </h2>
    </div>

    <div class="bg-white rounded-[24px] border border-gray-100 ambient-shadow overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-gray-300 text-5xl mb-2">group</span>
                <p class="text-gray-500 font-medium text-sm">Chưa có ai trong danh sách này.</p>
            </div>
        }
        else
        {
            @foreach (var u in Model)
            {
                <a asp-controller="Profile" asp-action="Details" asp-route-id="@u.Id" class="flex items-center gap-3 p-4 border-b border-gray-50 last:border-b-0 hover:bg-gray-50/60 transition-colors">
                    @if (!string.IsNullOrWhiteSpace(u.AvatarUrl))
                    {
                        <div class="w-11 h-11 rounded-full border-2 border-pet-primary-fixed overflow-hidden bg-gray-50 flex items-center justify-center shrink-0">
                            <img src="@u.AvatarUrl" alt="Avatar" class="w-11 h-11 object-cover" />
                        </div>
                    }
                    else
                    {
                        <div class="w-11 h-11 rounded-full border-2 border-pet-primary-fixed overflow-hidden bg-gray-50 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-gray-400 text-xl">person</span>
                        </div>
                    }
                    <div>
                        <h3 class="text-sm font-bold text-gray-800 font-['Plus_Jakarta_Sans'] leading-tight">@u.FullName</h3>
                        <p class="text-[11px] text-gray-400 font-medium mt-0.5">@u.Email</p>
                    </div>
                </a>
            }
        }
    </div>
</main>
