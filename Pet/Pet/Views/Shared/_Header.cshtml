<header class="app-header">
    <div class="app-header-left">
        <button type="button"
                class="app-header-toggle"
                data-sidebar-toggle
                aria-label="Ẩn/hiện thanh danh mục"
                aria-expanded="true">
            <i class="fa fa-bars"></i>
        </button>

        <a asp-area=""
           asp-controller="Post"
           asp-action="Community"
           class="app-header-brand">
            <span class="app-header-logo">
                <img src="~/images/logo.jpg" alt="PetSocial" />
            </span>
            <span>
                <strong>PetGr4</strong>
                <small>PetSocial</small>
            </span>
        </a>
    </div>

    <div class="app-header-right">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-area=""
               asp-controller="Profile"
               asp-action="Index"
               class="app-header-account">
                <span class="app-header-avatar">
                    <i class="fa fa-user"></i>
                </span>
                <span>
                    <small>Tài khoản</small>
                    <strong>@User.Identity.Name</strong>
                </span>
            </a>

            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="app-header-logout-form">
                <button type="submit" class="app-header-logout" aria-label="Đăng xuất">
                    <i class="fa fa-sign-out"></i>
                </button>
            </form>
        }
        else
        {
            <a asp-area=""
               asp-controller="Account"
               asp-action="Login"
               class="app-header-login">
                Đăng nhập
            </a>
        }
    </div>
</header>
