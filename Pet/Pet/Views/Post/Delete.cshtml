@model PetSocial.Models.Post

@{
    ViewData["Title"] = "Xác nhận xóa bài viết";
    var returnUrl = ViewBag.ReturnUrl ?? Context.Request.Query["returnUrl"];
}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

<div class="max-w-2xl mx-auto px-4 py-12">
    <div class="bg-white rounded-[24px] border-2 border-red-200 p-8 space-y-6 text-center shadow-md">
        <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto">
            <span class="material-symbols-outlined text-[40px]">warning</span>
        </div>

        <h1 class="text-xl font-black text-gray-900 md:text-2xl">Xác nhận xóa bài viết?</h1>
        <p class="text-sm text-gray-500">Hành động này không thể hoàn tác.</p>

        <div class="bg-red-50/50 rounded-2xl p-4 text-left border border-red-100">
            <p class="text-sm text-gray-700 italic">"@Model.Content"</p>
        </div>

        <form asp-action="Delete" method="post" class="flex items-center justify-center gap-4 pt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <a href="@(string.IsNullOrEmpty(returnUrl) ? "javascript:history.back()" : returnUrl)" class="px-6 py-2.5 rounded-full border text-gray-600 font-semibold text-sm hover:bg-gray-100">
                Quay lại
            </a>
            <button type="submit" class="px-8 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-semibold text-sm shadow-md">
                Xác nhận xóa
            </button>
        </form>
    </div>
</div>