@model PetSocial.Models.Post

@{
    ViewData["Title"] = "Chi tiết bài viết";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var hasLiked = Model.Likes.Any(l => l.UserId == currentUserId);
}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

<script>
    tailwind.config = {
    theme: {
    extend: {
    colors: {
    'pet-primary': '#FF6B00',
    'pet-primary-hover': '#E55A00',
    'pet-primary-fixed': '#FFF0E5'
    }
    }
    }
    }
</script>

<div class="max-w-3xl mx-auto px-4 py-8 text-[#161d1f]">
    @Html.AntiForgeryToken()

    <div class="mb-6">
        <a href="javascript:history.back()" class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-500 hover:text-pet-primary transition-colors bg-gray-50 hover:bg-orange-50 px-4 py-2 rounded-full border border-gray-100">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            <span>Quay lại danh sách</span>
        </a>
    </div>

    <article class="bg-white rounded-[24px] border border-gray-100 overflow-hidden p-6 space-y-5 shadow-sm">
        <header class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-100 border border-gray-200 flex items-center justify-center flex-shrink-0">
                @if (!string.IsNullOrWhiteSpace(Model.User?.AvatarUrl))
                {
                    <img src="@Model.User.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                }
                else
                {
                    <img src="/images/default-avatar.png" class="w-full h-full object-cover" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=@(Model.UserId)'" alt="default avatar" />
                }
            </div>
            <div>
                <h2 class="text-sm font-extrabold text-gray-900">@(Model.User?.FullName ?? "Thành viên cộng đồng")</h2>
                <p class="text-[11px] text-gray-400">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </header>

        <section class="space-y-4">
            <p class="text-sm md:text-base text-gray-800 leading-relaxed whitespace-pre-line">@Model.Content</p>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="rounded-2xl overflow-hidden border border-gray-100 bg-gray-50">
                    <img src="@Model.ImageUrl" alt="Post Image" class="w-full h-full object-contain mx-auto" />
                </div>
            }
        </section>

        <footer class="pt-4 border-t border-gray-50 flex items-center gap-6 text-xs font-bold text-gray-500">
            <button type="button" onclick="toggleLike(this)" data-post-id="@Model.Id" class="flex items-center gap-1.5 transition-all @(hasLiked ? "text-rose-500 font-bold" : "text-gray-500")">
                <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' @(hasLiked ? "1" : "0")">favorite</span>
                <span><span id="details-like-count">@(Model.Likes?.Count ?? 0)</span> Lượt thích</span>
            </button>
            <div class="flex items-center gap-1.5 text-pet-primary">
                <span class="material-symbols-outlined text-xl">chat_bubble</span>
                <span><span id="details-comment-count">@(Model.Comments?.Count ?? 0)</span> Bình luận</span>
            </div>
        </footer>
    </article>

    <section class="mt-6 bg-white rounded-[24px] border border-gray-100 p-6 space-y-6 shadow-sm">
        <h3 class="text-xs font-extrabold text-gray-900 uppercase tracking-wider flex items-center gap-1.5">
            <span class="material-symbols-outlined text-lg text-pet-primary">forum</span>
            <span>Ý kiến đóng góp công khai</span>
        </h3>

        <div id="details-comments-list" class="space-y-4 max-h-96 overflow-y-auto pr-2">
            @if (Model.Comments == null || !Model.Comments.Any())
            {
                <p id="details-no-comment-msg" class="text-xs text-gray-400 text-center py-6 border border-dashed rounded-xl">Chưa có bình luận nào cho bài viết này.</p>
            }
            else
            {
                @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                {
                    <div class="flex items-start gap-3 text-sm">
                        <div class="w-8 h-8 rounded-full overflow-hidden border bg-gray-100 flex-shrink-0 mt-0.5">
                            @if (!string.IsNullOrWhiteSpace(comment.User?.AvatarUrl))
                            {
                                <img src="@comment.User.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                            }
                            else
                            {
                                <img src="/images/default-avatar.png" class="w-full h-full object-cover" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=@(comment.UserId)'" alt="avatar" />
                            }
                        </div>
                        <div class="bg-gray-50 rounded-2xl px-4 py-2.5 max-w-[85%] flex-1">
                            <div class="flex items-center justify-between gap-4 mb-1">
                                <span class="font-bold text-gray-900">@(comment.User?.FullName ?? "Thành viên ẩn danh")</span>
                                <span class="text-[10px] text-gray-400">@comment.CreatedAt.ToString("dd/MM HH:mm")</span>
                            </div>
                            <p class="text-gray-700 leading-relaxed whitespace-pre-line">@comment.Content</p>
                        </div>
                    </div>
                }
            }
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="flex gap-3 pt-4 border-t border-gray-100">
                <input type="text" id="details-comment-input" placeholder="Viết bình luận của bạn..."
                       class="w-full bg-white border border-gray-200 text-sm px-4 py-2.5 rounded-full focus:ring-1 focus:ring-pet-primary focus:border-pet-primary outline-none transition-all"
                       onkeypress="if(event.key === 'Enter') submitDetailsComment()" />
                
                <button type="button" onclick="submitDetailsComment()"
                        class="bg-pet-primary hover:bg-pet-primary-hover text-white text-sm font-bold px-5 py-2.5 rounded-full transition-all active:scale-95 flex items-center gap-1 shadow-sm">
                    <span class="material-symbols-outlined text-sm">send</span>
                    <span>Gửi</span>
                </button>
            </div>
        }
    </section>
</div>

<script>
    function toggleLike(button) {
    const postId = @Model.Id;
    const icon = button.querySelector('.material-symbols-outlined');
    const countSpan = document.getElementById('details-like-count');
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    fetch(`/Post/ToggleLike?postId=${postId}`, { method: 'POST', headers: { 'RequestVerificationToken': token } })
    .then(r => r.json()).then(data => {
    if (data && data.success) {
    if (data.isLiked) {
    icon.style.fontVariationSettings = "'FILL' 1";
    button.classList.add('text-rose-500', 'font-bold');
    } else {
    icon.style.fontVariationSettings = "'FILL' 0";
    button.classList.remove('text-rose-500', 'font-bold');
    }
    if (countSpan) countSpan.innerText = data.count;
    }
    });
    }

    function submitDetailsComment() {
    const input = document.getElementById('details-comment-input');
    if (!input || !input.value.trim()) return;

    const content = input.value.trim();
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    const formData = new FormData();
    formData.append('postId', @Model.Id);
    formData.append('commentContent', content);

    fetch('/Post/AddCommentAjax', {
    method: 'POST',
    headers: { 'RequestVerificationToken': token },
    body: formData
    })
    .then(res => res.json())
    .then(data => {
    if (data && data.success) {
    input.value = ''; // Xóa dữ liệu cũ trong ô nhập

    // Ẩn thông báo "Chưa có bình luận"
    const msg = document.getElementById('details-no-comment-msg');
    if(msg) msg.remove();

    // Chèn mã HTML bình luận mới vào cuối danh sách
    const list = document.getElementById('details-comments-list');
    const avatar = data.avatarUrl ? data.avatarUrl : '/images/default-avatar.png';
                
    const newCommentHtml = `
    <div class="flex items-start gap-3 text-sm animate-[fadeIn_0.3s_ease]">
    <div class="w-8 h-8 rounded-full overflow-hidden border bg-gray-100 flex-shrink-0 mt-0.5">
    <img src="${avatar}" class="w-full h-full object-cover" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=' + Math.random()" />
    </div>
    <div class="bg-gray-50 rounded-2xl px-4 py-2.5 max-w-[85%] flex-1">
    <div class="flex items-center justify-between gap-4 mb-1">
    <span class="font-bold text-gray-900">${data.authorName}</span>
    <span class="text-[10px] text-gray-400">${data.createdAt}</span>
    </div>
    <p class="text-gray-700 leading-relaxed whitespace-pre-line">${data.content}</p>
    </div>
    </div>
    `;
    list.insertAdjacentHTML('beforeend', newCommentHtml);
    list.scrollTop = list.scrollHeight; // Cuộn mượt xuống phía dưới

    // Tăng bộ đếm bình luận
    const countSpan = document.getElementById('details-comment-count');
    if(countSpan) {
    countSpan.innerText = parseInt(countSpan.innerText || '0') + 1;
    }
    }
    });
    }
</script>