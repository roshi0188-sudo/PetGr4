@model PetSocial.Models.Post

@{
    ViewData["Title"] = "Chi tiết bài viết | PawPals";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var hasLiked = Model.Likes.Any(l => l.UserId == currentUserId);
}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&family=Nunito+Sans:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

<style>
    body { background-color: #FFFFF; }
    .custom-shadow { box-shadow: 0 12px 20px rgba(45, 52, 54, 0.04); }
</style>

<div class="max-w-3xl mx-auto px-4 py-8 font-['Nunito_Sans'] text-[#161d1f]">
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm text-[#544437] hover:text-[#8f4e00] font-semibold transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span> Quay lại bảng tin
        </a>
    </div>

    <article class="bg-white rounded-[24px] custom-shadow border border-[#e8eff1] overflow-hidden mb-8">
        <div class="p-6 flex items-center justify-between border-b border-[#e8eff1]">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#ffdcc2] overflow-hidden flex items-center justify-center border border-orange-100">
                    @if (!string.IsNullOrWhiteSpace(Model.User?.AvatarUrl))
                    {
                        <img src="@Model.User.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-2xl text-[#8f4e00]">account_circle</span>
                    }
                </div>
                <div>
                    <h3 class="font-bold text-base text-[#161d1f]">
                        @(Model.User?.FullName ?? "Thành viên ẩn danh")
                    </h3>
                    <p class="text-xs text-[#544437] flex items-center gap-1 mt-0.5">
                        <span class="material-symbols-outlined text-xs">schedule</span>
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>
            
            <span class="px-3 py-1 rounded-full bg-[#6dfad2]/40 text-[#005140] text-xs font-bold">
                Cộng đồng
            </span>
        </div>

        <div class="p-6 space-y-6">
            <p class="text-lg leading-relaxed whitespace-pre-line text-[#161d1f]">
                @Model.Content
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="rounded-2xl overflow-hidden shadow-sm border border-gray-100 max-h-[500px] bg-gray-50 flex justify-center items-center">
                    <img src="@Model.ImageUrl" class="w-full h-full object-cover max-h-[500px]" alt="Hình ảnh minh họa" />
                </div>
            }
        </div>

        <div class="px-6 py-4 bg-[#f4fafd] flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-[#e8eff1]">
            <form asp-action="ToggleLike" method="post" class="inline-block">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Id" />
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2 rounded-full border @(hasLiked ? "bg-red-50 border-red-200 text-red-600" : "bg-white border-[#dac2b1] text-gray-600 hover:bg-gray-50") text-sm font-semibold transition-all">
                    <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' @(hasLiked ? "1" : "0")">favorite</span>
                    Thích (@Model.Likes.Count)
                </button>
            </form>

            <div class="flex items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || currentUserId == Model.UserId))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1 px-4 py-2 rounded-full border border-[#006b55] text-[#006b55] font-semibold text-xs hover:bg-[#6dfad2]/20 transition-all">
                        <span class="material-symbols-outlined text-sm">edit</span> Sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center gap-1 px-4 py-2 rounded-full bg-[#ba1a1a] text-white font-semibold text-xs hover:bg-red-700 transition-all">
                        <span class="material-symbols-outlined text-sm">delete</span> Xóa
                    </a>
                }
            </div>
        </div>
    </article>

    <section class="bg-white rounded-[24px] custom-shadow border border-[#e8eff1] p-6 space-y-6">
        <h3 class="text-xl font-bold text-[#161d1f] font-['Quicksand'] flex items-center gap-2">
            <span class="material-symbols-outlined text-[#8f4e00]">chat_bubble</span>
            Bình luận (@Model.Comments.Count)
        </h3>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-action="AddComment" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Id" />
                <div class="border border-[#dac2b1] rounded-xl overflow-hidden focus-within:ring-2 focus-within:ring-[#8f4e00] transition-all bg-white">
                    <textarea name="commentContent" rows="3" class="w-full px-4 py-3 border-none focus:ring-0 outline-none text-[#161d1f] text-sm resize-none" placeholder="Chia sẻ suy nghĩ của bạn về bài viết này..." required></textarea>
                </div>
                <div class="text-right">
                    <button type="submit" class="px-6 py-2 rounded-full bg-[#8f4e00] text-white font-semibold text-sm shadow-sm hover:scale-[1.02] active:scale-95 transition-all">
                        Gửi bình luận
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="bg-gray-50 border border-dashed border-gray-200 rounded-xl p-4 text-center text-sm text-gray-500">
                Vui lòng đăng nhập để tham gia bình luận bài viết này.
            </div>
        }

        <div class="space-y-4 pt-4 border-t border-gray-100">
            @if (!Model.Comments.Any())
            {
                <p class="text-center text-sm text-gray-400 py-4">Chưa có bình luận nào. Hãy là người đầu tiên!</p>
            }
            else
            {
                @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                {
                    <div class="flex items-start gap-3 text-sm">
                        <div class="w-8 h-8 rounded-full bg-orange-100 overflow-hidden flex items-center justify-center flex-shrink-0 mt-0.5">
                            @if (!string.IsNullOrWhiteSpace(comment.User?.AvatarUrl))
                            {
                                <img src="@comment.User.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-lg text-[#8f4e00]">account_circle</span>
                            }
                        </div>
                        <div class="bg-gray-50 rounded-2xl px-4 py-2.5 max-w-[85%] flex-1">
                            <div class="flex items-center justify-between gap-4 mb-1">
                                <span class="font-bold text-[#161d1f]">@(comment.User?.FullName ?? "Thành viên ẩn danh")</span>
                                <span class="text-[10px] text-gray-400">@comment.CreatedAt.ToString("dd/MM HH:mm")</span>
                            </div>
                            <p class="text-gray-700 leading-relaxed whitespace-pre-line">@comment.Content</p>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>