@model IEnumerable<PetSocial.Models.Post>

@{
    ViewData["Title"] = (ViewBag.PageTitle ?? "Bảng tin") + " - PetSocial";
    ViewData["FullWidth"] = true;
    var currentUserId = ViewBag.CurrentUserId as string;
    bool isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<script>
    tailwind.config = {
    theme: {
    extend: {
    colors: {
    'pet-primary': '#FF6B00',
    'pet-primary-hover': '#E55A00',
    'pet-primary-fixed': '#FFF0E5',
    'pet-secondary': '#356668'
    }
    }
    }
    }
</script>

<div class="app-shell-content-container w-full max-w-3xl mx-auto px-4 sm:px-6 py-6 lg:py-8">
    @Html.AntiForgeryToken()

    <div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-100">
        <div class="flex items-center gap-3">
            <div class="w-2 h-6 bg-pet-primary rounded-full"></div>
            <h1 class="text-xl font-extrabold text-gray-900 tracking-tight">@(ViewBag.PageTitle ?? "Bài viết mới nhất")</h1>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" asp-route-returnUrl="@currentUrl" class="inline-flex items-center gap-2 bg-pet-primary hover:bg-pet-primary-hover text-white font-bold text-sm px-5 py-2.5 rounded-full transition-all active:scale-95">
                <span class="material-symbols-outlined text-lg font-bold">add</span>
                <span>Đăng bài mới</span>
            </a>
        }
    </div>

    <div class="flex flex-col gap-6">
        @if (!Model.Any())
        {
            <div class="bg-white rounded-[24px] p-16 text-center border border-gray-100 shadow-sm">
                <p class="text-sm text-gray-400">Không tìm thấy bài viết hiển thị tại mục này.</p>
            </div>
        }
        else
        {
            @foreach (var post in Model)
            {
                bool isLikedByMe = !string.IsNullOrEmpty(currentUserId) && post.Likes != null && post.Likes.Any(l => l.UserId == currentUserId);
                int totalLikesCount = post.Likes?.Count ?? 0;
                bool canManagePost = isAdmin || (post.UserId == currentUserId);

                <article class="bg-white rounded-[24px] border border-gray-100 overflow-hidden shadow-sm">
                    <div class="p-5 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-full overflow-hidden bg-gray-100 border border-gray-200 flex items-center justify-center flex-shrink-0">
                                @if (!string.IsNullOrWhiteSpace(post.User?.AvatarUrl))
                                {
                                    <img src="@post.User.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                                }
                                else
                                {
                                    <img src="/images/default-avatar.png" class="w-full h-full object-cover" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=@(post.UserId)'" alt="default avatar" />
                                }
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-gray-900">@(post.User?.FullName ?? "Người dùng")</h3>
                                <p class="text-[11px] text-gray-400">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-1 bg-gray-50 p-1 rounded-full">
                            <a asp-action="Details" asp-route-id="@post.Id" class="text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-white px-3 py-1.5 rounded-full transition-all">Chi tiết</a>

                            @if (canManagePost)
                            {
                                <a asp-action="Edit" asp-route-id="@post.Id" asp-route-returnUrl="@currentUrl" class="text-gray-400 hover:text-amber-600 p-1.5 rounded-full hover:bg-white flex items-center justify-center">
                                    <span class="material-symbols-outlined text-lg">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@post.Id" asp-route-returnUrl="@currentUrl" class="text-gray-400 hover:text-rose-600 p-1.5 rounded-full hover:bg-white flex items-center justify-center">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </a>
                            }
                        </div>
                    </div>

                    <div class="px-5 pb-4">
                        <p class="text-sm text-gray-800 mb-4 whitespace-pre-line">@post.Content</p>
                        @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                        {
                            <div class="rounded-2xl overflow-hidden bg-gray-100 border border-gray-100 flex items-center justify-center">
                                <img src="@post.ImageUrl"
                                     alt="Hình ảnh bài viết"
                                     class="w-full h-auto max-h-[500px] object-contain"
                                     style="display: block;" />
                            </div>
                        }
                    </div>

                    <div class="px-5 py-3.5 border-t border-gray-50 bg-white flex items-center justify-between">
                        <div class="flex gap-8">
                            <button type="button" onclick="toggleLike(this)" data-post-id="@post.Id" class="flex items-center gap-2 transition-all @(isLikedByMe ? "text-rose-500 font-bold" : "text-gray-500")">
                                <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' @(isLikedByMe ? "1" : "0")">favorite</span>
                                <span class="text-xs"><span class="like-count">@totalLikesCount</span> lượt thích</span>
                            </button>
                            <button type="button" onclick="toggleCommentsSection(@post.Id)" class="flex items-center gap-2 text-gray-500 font-medium hover:text-blue-600 transition-colors">
                                <span class="material-symbols-outlined text-xl">chat_bubble</span>
                                <span class="text-xs"><span id="comment-count-@post.Id">@(post.Comments?.Count ?? 0)</span> bình luận</span>
                            </button>
                        </div>
                    </div>

                    <div id="comments-section-@post.Id" class="hidden border-t border-gray-50 bg-gray-50/50 p-5 space-y-4">
                        <div id="comments-list-@post.Id" class="space-y-3 max-h-60 overflow-y-auto pr-1">
                            @if (post.Comments != null && post.Comments.Any())
                            {
                                foreach (var comment in post.Comments.OrderBy(c => c.CreatedAt))
                                {
                                    <div class="flex items-start gap-2.5 text-xs">
                                        <div class="w-7 h-7 rounded-full overflow-hidden border bg-gray-100 flex-shrink-0">
                                            @if (!string.IsNullOrWhiteSpace(comment.User?.AvatarUrl))
                                            {
                                                <img src="@comment.User.AvatarUrl" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <img src="/images/default-avatar.png" class="w-full h-full object-cover" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=@(comment.UserId)'" />
                                            }
                                        </div>
                                        <div class="bg-white border rounded-xl px-3 py-2 flex-1 shadow-2v">
                                            <div class="flex items-center justify-between mb-0.5">
                                                <span class="font-bold text-gray-900">@(comment.User?.FullName ?? "Thành viên")</span>
                                                <span class="text-[10px] text-gray-400">@comment.CreatedAt.ToString("dd/MM HH:mm")</span>
                                            </div>
                                            <p class="text-gray-700 leading-relaxed">@comment.Content</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p id="no-comment-msg-@post.Id" class="text-[11px] text-gray-400 text-center py-2 italic">Chưa có bình luận nào. Hãy trở thành người đầu tiên!</p>
                            }
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="flex gap-2 pt-2 border-t border-gray-100">
                                <input type="text" id="comment-input-@post.Id" placeholder="Viết bình luận của bạn..." class="w-full bg-white border border-gray-200 text-xs px-4 py-2 rounded-full focus:ring-1 focus:ring-pet-primary focus:border-pet-primary outline-none transition-all" onkeypress="if(event.key === 'Enter') submitCommentAjax(@post.Id)" />
                                <button type="button" onclick="submitCommentAjax(@post.Id)" class="bg-pet-primary hover:bg-pet-primary-hover text-white text-xs font-bold px-4 py-2 rounded-full transition-all active:scale-95 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">send</span>
                                </button>
                            </div>
                        }
                    </div>
                </article>
            }
        }
    </div>
</div>

<script>
    function toggleLike(button) {
    const postId = button.getAttribute('data-post-id');
    const icon = button.querySelector('.material-symbols-outlined');
    const countSpan = button.querySelector('.like-count');
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    fetch(`/Post/ToggleLike?postId=${postId}`, { method: 'POST', headers: { 'RequestVerificationToken': token } })
    .then(r => r.json()).then(data => {
    if (data && data.success) {
    if (data.isLiked) {
    icon.style.fontVariationSettings = "'FILL' 1";
    button.classList.add('text-rose-500', 'font-bold');
    } else {
    icon.style.fontVariationSettings = "'FILL' 0";
    button.classList.remove('text-rose-500', 'font-bold');
    }
    if (countSpan) countSpan.innerText = data.count;
    }
    });
    }

    // Hàm ẩn/hiện khu vực bình luận
    function toggleCommentsSection(postId) {
    const section = document.getElementById(`comments-section-${postId}`);
    if(section) {
    section.classList.toggle('hidden');
    }
    }

    // Hàm gửi bình luận Ajax
    function submitCommentAjax(postId) {
    const input = document.getElementById(`comment-input-${postId}`);
    if (!input || !input.value.trim()) return;

    const content = input.value.trim();
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    const formData = new FormData();
    formData.append('postId', postId);
    formData.append('commentContent', content);

    fetch('/Post/AddCommentAjax', {
    method: 'POST',
    headers: { 'RequestVerificationToken': token },
    body: formData
    })
    .then(res => res.json())
    .then(data => {
    if (data && data.success) {
    input.value = ''; // Xóa sạch ô nhập

    // Ẩn dòng thông báo trống
    const msg = document.getElementById(`no-comment-msg-${postId}`);
    if(msg) msg.remove();

    // Tạo giao diện bình luận mới chèn vào danh sách công khai công khai
    const list = document.getElementById(`comments-list-${postId}`);
    const avatar = data.avatarUrl ? data.avatarUrl : '/images/default-avatar.png';
                
    const newCommentHtml = `
    <div class="flex items-start gap-2.5 text-xs animate-[fadeIn_0.3s_ease]">
    <div class="w-7 h-7 rounded-full overflow-hidden border bg-gray-100 flex-shrink-0">
    <img src="${avatar}" class="w-full h-full object-cover" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=' + Math.random()" />
    </div>
    <div class="bg-white border rounded-xl px-3 py-2 flex-1 shadow-2v">
    <div class="flex items-center justify-between mb-0.5">
    <span class="font-bold text-gray-900">${data.authorName}</span>
    <span class="text-[10px] text-gray-400">${data.createdAt}</span>
    </div>
    <p class="text-gray-700 leading-relaxed">${data.content}</p>
    </div>
    </div>
    `;
    list.insertAdjacentHTML('beforeend', newCommentHtml);
    list.scrollTop = list.scrollHeight; // Tự động cuộn xuống cuối

    // Cập nhật bộ đếm bình luận hiển thị trên thanh điều hướng
    const countSpan = document.getElementById(`comment-count-${postId}`);
    if(countSpan) {
    countSpan.innerText = parseInt(countSpan.innerText || '0') + 1;
    }
    }
    });
    }
</script>