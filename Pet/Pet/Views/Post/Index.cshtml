@model IEnumerable<PetSocial.Models.Post>

@{
    // Tự động nhận diện tiêu đề linh hoạt từ Controller truyền sang
    ViewData["Title"] = (ViewBag.PageTitle ?? "Bảng tin") + " - PetGr4";
    ViewData["FullWidth"] = true;

    var currentUserId = ViewBag.CurrentUserId as string;
    bool isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<script>
    tailwind.config = {
    corePlugins: {
    preflight: false
    },
    darkMode: "class",
    theme: {
    extend: {
    colors: {
    'pet-primary': '#FF6B00',
    'pet-primary-hover': '#E55A00',
    'pet-primary-fixed': '#FFF0E5',
    'pet-secondary': '#356668',
    'pet-secondary-container': '#b9ecee',
    'pet-background': '#F8FAFC'
    }
    }
    }
    }
</script>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<style>
    body {
    background-color: #F8FAFC;
    }

    .ambient-shadow {
    box-shadow: 0 10px 30px rgba(21, 28, 39, 0.02);
    }

    .app-shell-content-container {
    width: 100%;
    max-width: 1540px;
    margin: 0 auto;
    padding: 34px 38px 72px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .post-feed-list {
    width: min(100%, 820px);
    margin: 0 auto;
    }

    .post-create-button {
    background: linear-gradient(135deg, #ff7e21, #ff6b00) !important;
    color: #ffffff !important;
    border: 0 !important;
    box-shadow: 0 14px 28px rgba(255, 107, 0, 0.24) !important;
    }

    .post-create-button:hover {
    background: linear-gradient(135deg, #ff6b00, #e55a00) !important;
    color: #ffffff !important;
    transform: translateY(-1px);
    }

    .post-create-button span {
    color: inherit !important;
    }

    .post-author-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    }

    .post-author-link:hover h3 {
    color: #ff6b00 !important;
    }

    .post-author-avatar {
    box-shadow: 0 0 0 3px #fff1e7;
    border: 2px solid #ff7e21;
    }

    .post-comment-form {
    display: flex;
    align-items: stretch;
    gap: 10px;
    }

    .post-comment-input-wrap {
    flex: 1 1 auto;
    min-width: 0;
    }

    .post-comment-submit {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    min-width: 42px;
    border: 0 !important;
    border-radius: 50% !important;
    background: transparent !important;
    color: #ff6b00 !important;
    font-weight: 900 !important;
    box-shadow: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    }

    .post-comment-submit:hover {
    background: #fff1e7 !important;
    color: #e55a00 !important;
    transform: translateY(-1px);
    }

    @@media (max-width: 860px) {
    .app-shell-content-container {
    padding: 24px 22px 56px;
    }
    }
</style>

<div class="app-shell-content-container">
    @Html.AntiForgeryToken()

    <div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-100">
        <div class="flex items-center gap-3">
            <div class="w-2 h-6 bg-pet-primary rounded-full"></div>
            <h1 class="pet-page-title text-xl font-extrabold text-gray-900 tracking-tight">@(ViewBag.PageTitle ?? "Bài viết mới nhất")</h1>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="post-create-button inline-flex items-center gap-2 bg-pet-primary hover:bg-pet-primary-hover text-white font-bold text-sm px-5 py-2.5 rounded-full transition-all shadow-md shadow-orange-500/10 active:scale-95">
                <span class="material-symbols-outlined text-lg font-bold">add</span>
                <span>Đăng bài mới</span>
            </a>
        }
    </div>

        <div class="post-feed-list flex flex-col gap-6">
        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border border-green-100 text-green-700 text-sm font-bold px-4 py-3 rounded-2xl">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border border-red-100 text-red-700 text-sm font-bold px-4 py-3 rounded-2xl">@TempData["Error"]</div>
        }

        @if (!Model.Any())
        {
            <div class="bg-white rounded-[24px] p-16 text-center border border-gray-100 ambient-shadow">
                <div class="w-20 h-20 bg-orange-50 text-pet-primary rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-4xl">auto_stories</span>
                </div>
                <h3 class="text-gray-900 font-extrabold text-base">Chưa có bài viết</h3>
                <p class="text-sm text-gray-400 mt-2 mb-6 max-w-sm mx-auto">Không tìm thấy bài viết hiển thị tại mục này.</p>
            </div>
        }
        else
        {
            @foreach (var post in Model)
            {
                bool isLikedByMe = !string.IsNullOrEmpty(currentUserId) && post.Likes != null && post.Likes.Any(l => l.UserId == currentUserId);
                int totalLikesCount = post.Likes?.Count ?? 0;
                bool canManagePost = isAdmin || (post.UserId == currentUserId);

                <article class="bg-white rounded-[24px] border border-gray-100 overflow-hidden ambient-shadow transition-all duration-300">
                    
                    <div class="p-5 flex items-center justify-between">
                        <a asp-controller="Profile"
                           asp-action="Details"
                           asp-route-id="@post.UserId"
                           class="post-author-link">
                            @if (!string.IsNullOrWhiteSpace(post.User?.AvatarUrl))
                            {
                                <img src="@post.User.AvatarUrl" alt="Avatar" class="post-author-avatar w-11 h-11 rounded-full object-cover" />
                            }
                            else
                            {
                                <div class="post-author-avatar w-11 h-11 rounded-full bg-orange-100 text-pet-primary flex items-center justify-center font-bold text-sm">
                                    @((string.IsNullOrEmpty(post.User?.FullName) ? "U" : post.User.FullName.Substring(0, 1).ToUpper()))
                                </div>
                            }
                            <div>
                                <h3 class="text-sm font-extrabold text-gray-900 leading-tight">@(post.User?.FullName ?? "Người dùng")</h3>
                                <p class="text-[11px] text-gray-400 font-medium mt-0.5 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[12px]">schedule</span>
                                    @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                        </a>

                        <div class="flex items-center gap-1 bg-gray-50 p-1 rounded-full">
                            <a asp-action="Details" asp-route-id="@post.Id" class="text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-white px-3 py-1.5 rounded-full transition-all">Chi tiết</a>

                            @if (canManagePost)
                            {
                                <a asp-action="Edit" asp-route-id="@post.Id" class="text-gray-400 hover:text-amber-600 p-1.5 rounded-full hover:bg-white flex items-center justify-center transition-colors">
                                    <span class="material-symbols-outlined text-lg">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@post.Id" class="text-gray-400 hover:text-rose-600 p-1.5 rounded-full hover:bg-white flex items-center justify-center transition-colors">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </a>
                            }
                        </div>
                    </div>

                    <div class="px-5 pb-4">
                        <p class="text-sm text-gray-800 font-medium leading-relaxed mb-4 whitespace-pre-line">@post.Content</p>
                        
                        @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                        {
                            <div class="mt-4 w-full rounded-2xl overflow-hidden bg-gray-100 border border-gray-100 flex items-center justify-center min-h-[200px]">
                                <img src="@Url.Content(post.ImageUrl)"
                                     alt="Hình ảnh bài viết"
                                     class="w-full h-auto object-cover"
                                     onerror="this.onerror=null; this.src='/images/default-post.jpg';" />
                            </div>
                        }
                    </div>

                    <div class="px-5 py-3.5 border-t border-gray-50 bg-white flex items-center justify-between">
                        <div class="flex gap-8">
                            <button type="button" onclick="toggleLike(this)" data-post-id="@post.Id" class="flex items-center gap-1.5 transition-all group @(isLikedByMe ? "text-rose-500 font-bold" : "text-gray-500 hover:text-rose-500")">
                                <span class="material-symbols-outlined text-xl transition-transform group-active:scale-125" style="font-variation-settings: 'FILL' @(isLikedByMe ? "1" : "0"), 'wght' 400, 'GRAD' 0, 'opsz' 24 !important;">favorite</span>
                                <span class="text-xs font-bold">
                                    <span class="like-count">@totalLikesCount</span> lượt thích
                                </span>
                            </button>
                            
                            <button type="button" onclick="toggleComments(this)" data-post-id="@post.Id" class="flex items-center gap-1.5 text-gray-500 hover:text-pet-primary transition-colors font-medium">
                                <span class="material-symbols-outlined text-xl">chat_bubble</span>
                                <span class="text-xs font-bold">
                                    <span class="comment-count-label">@(post.Comments?.Count ?? 0)</span> bình luận
                                </span>
                            </button>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true && !canManagePost)
                        {
                            <form asp-action="Report" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <input type="hidden" name="reason" value="Nội dung vi phạm" />
                                <button type="submit"
                                        class="flex items-center gap-1.5 text-gray-400 hover:text-rose-600 transition-colors font-bold text-xs"
                                        onclick="return confirm('Gửi báo cáo bài viết này đến quản trị viên?')">
                                    <span class="material-symbols-outlined text-xl">flag</span>
                                    <span>Báo cáo</span>
                                </button>
                            </form>
                        }
                    </div>

                    <div id="comments-@post.Id" class="hidden border-t border-gray-100 px-5 py-4 bg-gray-50/30 space-y-4">
                        <div id="comment-list-@post.Id" class="space-y-3 max-h-80 overflow-y-auto pr-1">
                            @if (post.Comments != null && post.Comments.Any())
                            {
                                @foreach (var comment in post.Comments.OrderBy(c => c.CreatedAt))
                                {
                                    <div class="flex items-start gap-2.5 text-sm">
                                        <div class="w-8 h-8 rounded-full bg-orange-100 overflow-hidden flex-shrink-0 flex items-center justify-center ring-1 ring-orange-200">
                                            @if (!string.IsNullOrWhiteSpace(comment.User?.AvatarUrl))
                                            {
                                                <img src="@comment.User.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                                            }
                                            else
                                            {
                                                <span class="text-xs font-bold text-pet-primary">@((comment.User?.FullName ?? "U").Substring(0, 1).ToUpper())</span>
                                            }
                                        </div>
                                        <div class="bg-white rounded-2xl px-3 py-2 flex-1 border border-gray-100 shadow-sm">
                                            <div class="flex justify-between items-center mb-0.5">
                                                <span class="font-extrabold text-gray-900 text-xs">@(comment.User?.FullName ?? "Thành viên")</span>
                                                <span class="text-[10px] text-gray-400">@comment.CreatedAt.ToString("dd/MM HH:mm")</span>
                                            </div>
                                            <p class="text-gray-700 leading-relaxed text-xs">@comment.Content</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-center text-xs text-gray-400 py-3 bg-white rounded-xl border border-dashed border-gray-100" id="no-comment-msg-@post.Id">Chưa có bình luận nào. Hãy là người đầu tiên để lại ý kiến!</p>
                            }
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="post-comment-form pt-2 border-t border-gray-100">
                                <div class="post-comment-input-wrap border border-gray-200 rounded-xl overflow-hidden focus-within:ring-2 focus-within:ring-pet-primary transition-all bg-white shadow-sm">
                                    <textarea id="comment-input-@post.Id" rows="2" class="w-full px-3 py-2 border-none focus:ring-0 outline-none text-gray-800 text-xs resize-none" placeholder="Viết bình luận công khai..."></textarea>
                                </div>
                                <button type="button" onclick="submitComment(@post.Id)" class="post-comment-submit transition-all active:scale-95" aria-label="Gửi bình luận">
                                    <span class="material-symbols-outlined text-[22px]">send</span>
                                </button>
                            </div>
                        }
                    </div>
                </article>
            }
        }
    </div>
</div>

<script>
    function toggleComments(btn) {
    const postId = btn.getAttribute('data-post-id');
    const panel = document.getElementById('comments-' + postId);
    if (!panel) return;
    panel.classList.toggle('hidden');
    }

    function submitComment(postId) {
    const input = document.getElementById('comment-input-' + postId);
    const content = input ? input.value.trim() : '';
    if (!content) return;

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const body = new URLSearchParams({ postId, commentContent: content });

    fetch('/Post/AddCommentAjax', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/x-www-form-urlencoded',
    'RequestVerificationToken': token
    },
    body: body.toString()
    })
    .then(r => r.json())
    .then(data => {
    if (!data.success) return;
    input.value = '';

    const noMsg = document.getElementById('no-comment-msg-' + postId);
    if (noMsg) noMsg.remove();

    const list = document.getElementById('comment-list-' + postId);
    if (!list) return;
    const initial = data.authorName ? data.authorName.charAt(0).toUpperCase() : 'U';
    const avatarHtml = data.avatarUrl
    ? `<img src="${data.avatarUrl}" class="w-full h-full object-cover" alt="avatar" />`
    : `<span class="text-xs font-bold text-pet-primary">${initial}</span>`;

    const commentHtml = `
    <div class="flex items-start gap-2.5 text-sm">
    <div class="w-8 h-8 rounded-full bg-orange-100 overflow-hidden flex-shrink-0 flex items-center justify-center ring-1 ring-orange-200">
    ${avatarHtml}
    </div>
    <div class="bg-white rounded-2xl px-3 py-2 flex-1 border border-gray-100 shadow-sm">
    <div class="flex justify-between items-center mb-0.5">
    <span class="font-extrabold text-gray-900 text-xs">${data.authorName ?? 'Thành viên'}</span>
    <span class="text-[10px] text-gray-400">${data.createdAt}</span>
    </div>
    <p class="text-gray-700 leading-relaxed text-xs">${data.content.replace(/</g,'&lt;')}</p>
    </div>
    </div>`;
    list.insertAdjacentHTML('beforeend', commentHtml);
    list.scrollTop = list.scrollHeight;

    const btn = document.querySelector(`[data-post-id="${postId}"] .comment-count-label`);
    if (btn) {
    const match = btn.textContent.match(/\d+/);
    const current = match ? parseInt(match[0]) : 0;
    btn.textContent = (current + 1) + ' bình luận';
    }
    })
    .catch(err => console.error('Lỗi bình luận:', err));
    }

    function toggleLike(button) {
    const postId = button.getAttribute('data-post-id');
    if (!postId) return;
    const icon = button.querySelector('.material-symbols-outlined');
    const countSpan = button.querySelector('.like-count');
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    fetch(`/Post/ToggleLike?postId=${postId}`, {
    method: 'POST',
    headers: { 'RequestVerificationToken': token }
    })
    .then(response => response.json())
    .then(data => {
    if (data && data.success) {
    if (data.isLiked) {
    icon.style.setProperty('font-variation-settings', "'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24", 'important');
    button.classList.add('text-rose-500', 'font-bold');
    button.classList.remove('text-gray-500');
    } else {
    icon.style.setProperty('font-variation-settings', "'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24", 'important');
    button.classList.remove('text-rose-500', 'font-bold');
    button.classList.add('text-gray-500');
    }
    if (countSpan) countSpan.innerText = data.count;
    }
    }).catch(err => console.error('Lỗi Like:', err));
    }
</script>
