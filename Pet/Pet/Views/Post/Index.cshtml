@model IEnumerable<PetSocial.Models.Post>

@{
    ViewData["Title"] = "Bài viết của tôi - PetSocial";
    // Đảm bảo lấy đúng thông tin ID người dùng hiện tại từ ViewBag để đối chiếu
    var currentUserId = ViewBag.CurrentUserId as string;
    bool isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<script>
    tailwind.config = {
    darkMode: "class",
    theme: {
    extend: {
    colors: {
    'pet-primary': '#FF6B00',         /* Sắc cam MXH đồng bộ */
    'pet-primary-hover': '#E55A00',
    'pet-primary-fixed': '#FFF0E5',
    'pet-secondary': '#356668',
    'pet-secondary-container': '#b9ecee',
    'pet-background': '#F8FAFC'
    }
    }
    }
    }
</script>

<style>
    body {
    background-color: #F8FAFC;
    font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .ambient-shadow {
    box-shadow: 0 10px 30px rgba(21, 28, 39, 0.02);
    }
</style>

<main class="max-w-2xl mx-auto px-4 py-8" style="margin-left: 280px;">
    @Html.AntiForgeryToken()

    <div class="flex justify-between items-center mb-6">
        <div class="flex items-center gap-5">
            
            <span class="text-sm font-black text-gray-900 border-b-2 border-pet-primary pb-1.5 tracking-tight">Bài viết của tôi</span>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="inline-flex items-center gap-1.5 bg-pet-primary hover:bg-pet-primary-hover text-white font-bold text-xs px-5 py-2.5 rounded-full transition-all shadow-sm active:scale-95">
                <span class="material-symbols-outlined text-sm font-bold">add</span> Đăng bài mới
            </a>
        }
    </div>

    <div class="flex flex-col gap-6">
        @if (!Model.Any())
        {
            <div class="bg-white rounded-[24px] p-12 text-center border border-gray-100 ambient-shadow">
                <div class="w-16 h-16 bg-gray-50 text-gray-300 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-3xl">auto_stories</span>
                </div>
                <p class="text-gray-500 font-bold text-sm">Nhật ký của bạn đang trống</p>
                <p class="text-xs text-gray-400 mt-1 mb-4">Hãy chia sẻ câu chuyện đáng yêu đầu tiên về thú cưng của bạn nào!</p>
                <a asp-action="Create" class="inline-flex items-center gap-1.5 bg-pet-primary hover:bg-pet-primary-hover text-white font-bold text-xs px-5 py-2.5 rounded-full transition-colors">
                    Viết bài ngay
                </a>
            </div>
        }
        else
        {
            @foreach (var post in Model)
            {
                bool isLikedByMe = !string.IsNullOrEmpty(currentUserId) && post.Likes != null && post.Likes.Any(l => l.UserId == currentUserId);
                int totalLikesCount = post.Likes?.Count ?? 0;

                // KIỂM TRA NGHIỆP VỤ BẢO MẬT: Phải là chủ bài đăng hoặc Admin mới hiện nút sửa/xóa
                bool canManagePost = isAdmin || (post.UserId == currentUserId);

                <article class="bg-white rounded-[24px] border border-gray-100 overflow-hidden ambient-shadow transition-all duration-200">
                    <div class="p-5 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(post.User?.AvatarUrl))
                            {
                                <img src="@post.User.AvatarUrl" alt="Avatar" class="w-11 h-11 rounded-full object-cover ring-2 ring-pet-primary-fixed" />
                            }
                            else
                            {
                                <div class="w-11 h-11 rounded-full bg-orange-100 text-pet-primary flex items-center justify-center font-bold text-sm">
                                    @(string.IsNullOrEmpty(post.User?.FullName) ? "U" : post.User.FullName.Substring(0, 1).ToUpper())
                                </div>
                            }
                            <div>
                                <h3 class="text-sm font-extrabold text-gray-900 leading-tight">@(post.User?.FullName ?? "Người dùng")</h3>
                                <p class="text-[11px] text-gray-400 font-medium mt-0.5">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-1">
                            <a asp-action="Details" asp-route-id="@post.Id" class="text-xs font-bold text-gray-500 bg-gray-50 hover:bg-gray-100 px-3 py-2 rounded-full transition-colors me-1">Chi tiết</a>

                            @if (canManagePost)
                            {
                                <a asp-action="Edit" asp-route-id="@post.Id" class="text-gray-400 hover:text-amber-500 p-2 rounded-full hover:bg-amber-50 flex items-center justify-center transition-colors"><span class="material-symbols-outlined text-lg">edit</span></a>
                                <a asp-action="Delete" asp-route-id="@post.Id" class="text-gray-400 hover:text-rose-600 p-2 rounded-full hover:bg-rose-50 flex items-center justify-center transition-colors"><span class="material-symbols-outlined text-lg">delete</span></a>
                            }
                        </div>
                    </div>

                    <div class="px-5 pb-4">
                        <p class="text-sm text-gray-800 font-medium leading-relaxed mb-3 whitespace-pre-line">@post.Content</p>
                        @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                        {
                            <div class="rounded-2xl overflow-hidden max-h-[380px] bg-gray-50 border border-gray-50">
                                <img src="@post.ImageUrl" alt="Hình ảnh đính kèm" class="w-full h-full object-cover" />
                            </div>
                        }
                    </div>

                    <div class="px-5 py-3.5 border-t border-gray-50 bg-gray-50/30 flex items-center justify-between">
                        <div class="flex gap-6">
                            <button type="button" onclick="toggleLike(this)" data-post-id="@post.Id" class="flex items-center gap-1.5 transition-colors group @(isLikedByMe ? "text-rose-500 font-bold" : "text-gray-500 hover:text-rose-500")">
                                <span class="material-symbols-outlined text-xl transition-transform group-active:scale-125" style="@(isLikedByMe ? "font-variation-settings: 'FILL' 1" : "font-variation-settings: 'FILL' 0")">favorite</span>
                                <span class="text-xs">@(isLikedByMe ? "Đã thích" : "Yêu thích")</span>
                                <span class="like-count text-xs font-bold bg-gray-100 group-hover:bg-rose-50 px-1.5 py-0.5 rounded-md">@totalLikesCount</span>
                            </button>
                            <a asp-action="Details" asp-route-id="@post.Id" class="flex items-center gap-1.5 text-gray-500 hover:text-pet-primary transition-colors font-medium">
                                <span class="material-symbols-outlined text-xl">chat_bubble</span>
                                <span class="text-xs">@(post.Comments?.Count ?? 0) bình luận</span>
                            </a>
                        </div>
                    </div>
                </article>
            }
        }
    </div>
</main>

<script>
    function toggleLike(button) {
    const postId = button.getAttribute('data-post-id');
    if (!postId) return;
    const icon = button.querySelector('.material-symbols-outlined');
    const text = button.querySelector('span:not(.material-symbols-outlined)');
    const countSpan = button.querySelector('.like-count');
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    fetch(`/Post/ToggleLike?postId=${postId}`, {
    method: 'POST',
    headers: { 'RequestVerificationToken': token }
    })
    .then(response => response.json())
    .then(data => {
    if (data && data.success) {
    if (data.isLiked) {
    icon.style.fontVariationSettings = "'FILL' 1";
    button.classList.add('text-rose-500', 'font-bold');
    button.classList.remove('text-gray-500');
    if (text) text.innerText = "Đã thích";
    } else {
    icon.style.fontVariationSettings = "'FILL' 0";
    button.classList.remove('text-rose-500', 'font-bold');
    button.classList.add('text-gray-500');
    if (text) text.innerText = "Yêu thích";
    }
    if (countSpan) countSpan.innerText = data.count;
    }
    }).catch(err => console.error('Lỗi Like:', err));
    }
</script>