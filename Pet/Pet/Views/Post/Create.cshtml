@model PetSocial.Models.Post

@{
    ViewData["Title"] = "Tạo bài viết - PetPark";
}

<!-- Cài đặt Font & Icon chuẩn của Google -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1" rel="stylesheet" />

<!-- Load Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
    theme: {
    extend: {
    colors: {
    'pet-primary': '#944a18',
    'pet-primary-fixed': '#ffdbc9',
    'pet-secondary': '#356668',
    'pet-secondary-container': '#b9ecee',
    'pet-background': '#fbf9f8',
    'pet-surface-variant': '#e4e2e2'
    }
    }
    }
    }
</script>

<style>
    body {
    background-color: #fbf9f8;
    font-family: 'Quicksand', sans-serif;
    }

    .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    font-family: 'Material Symbols Outlined';
    display: inline-block;
    vertical-align: middle;
    line-height: 1;
    }

    .ambient-shadow {
    box-shadow: 0 4px 20px rgba(148, 74, 24, 0.06);
    }
</style>

<div class="max-w-4xl mx-auto px-4 py-8 pb-24">
    
    <!-- TIÊU ĐỀ TRANG -->
    <div class="mb-4 flex items-center justify-between">
        <h2 class="text-2xl font-extrabold text-gray-800 font-['Plus_Jakarta_Sans']">Tạo bài viết</h2>
        <span class="text-gray-500 text-xs bg-gray-200/75 px-3 py-1 rounded-full font-medium">Bản nháp</span>
    </div>

    <!-- KHU VỰC FORM CHÍNH -->
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="bg-white rounded-2xl border border-gray-100 ambient-shadow overflow-hidden">
        
        <!-- Thông tin User -->
        <div class="p-6 flex items-center gap-3 border-b border-gray-50 bg-gray-50/30">
            <div class="w-11 h-11 rounded-full border-2 border-pet-primary-fixed overflow-hidden bg-gray-50 flex items-center justify-center flex-shrink-0">
                @if (Model?.User != null && !string.IsNullOrWhiteSpace(Model.User.AvatarUrl))
                {
                    <img src="@Model.User.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                }
                else
                {
                    <span class="material-symbols-outlined text-gray-400 text-xl">person</span>
                }
            </div>
            <div>
                <p class="font-bold text-gray-800 text-sm">@(User.Identity?.Name ?? "chanh@gmail.com")</p>
                <div class="inline-flex items-center gap-1 px-2 py-0.5 bg-gray-100 rounded text-xs text-gray-600 mt-0.5">
                    <span>Tác giả</span>
                </div>
            </div>
        </div>

        <!-- Nội dung text -->
        <div class="p-6">
            <textarea asp-for="Content"
                      class="w-full min-h-[140px] text-gray-800 placeholder-gray-400 border-none resize-none focus:outline-none focus:ring-0 p-0 text-base leading-relaxed"
                      id="post-content"
                      placeholder="Bạn đang nghĩ gì về thú cưng của mình?"></textarea>
            <span asp-validation-for="Content" class="text-red-500 text-xs block mt-1"></span>
        </div>

        <!-- Khu vực tải và xem trước hình ảnh -->
        <div class="px-6 pb-6">
            <div class="relative group border-2 border-dashed border-gray-200 hover:border-pet-primary rounded-xl aspect-video w-full max-h-[340px] flex flex-col items-center justify-center bg-gray-50/50 hover:bg-gray-50 transition-all duration-200 overflow-hidden">
                
                <input type="file" name="imageFile" id="imageFile" accept="image/*"
                       class="absolute inset-0 opacity-0 cursor-pointer z-20 w-full h-full"
                       onchange="previewImage(event)" />
                
                <!-- Trạng thái chưa có ảnh -->
                <div id="upload-placeholder" class="flex flex-col items-center justify-center p-4 text-center z-10">
                    <div class="w-12 h-12 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center text-gray-500 mb-2 group-hover:text-pet-primary transition-colors">
                        <span class="material-symbols-outlined text-xl">add_a_photo</span>
                    </div>
                    <p class="text-sm font-bold text-gray-700">Tải ảnh minh họa lên</p>
                    <p class="text-xs text-gray-400 mt-1">Hỗ trợ định dạng JPG, PNG, GIF (Tối đa 10MB)</p>
                </div>

                <!-- Trạng thái xem trước ảnh -->
                <div id="preview-wrapper" class="hidden absolute inset-0 w-full h-full z-10 bg-white flex items-center justify-center">
                    <img id="image-preview" src="#" alt="Preview" class="w-full h-full object-contain bg-black/5" />
                    <button type="button" onclick="clearImagePreview(event)"
                            class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/70 hover:bg-black text-white flex items-center justify-center shadow transition-colors z-30">
                        <span class="material-symbols-outlined text-sm">close</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Chức năng phụ (Gắn thẻ, Vị trí, Cảm xúc) -->
        <div class="px-6 py-3 bg-gray-50/50 border-t border-gray-100 flex flex-wrap gap-2">
            <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-xs font-semibold text-gray-600 hover:bg-gray-50 active:scale-95 transition-all">
                <span class="material-symbols-outlined text-base text-orange-500">sell</span>
                <span>Gắn thẻ pet</span>
            </button>
            <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-xs font-semibold text-gray-600 hover:bg-gray-50 active:scale-95 transition-all">
                <span class="material-symbols-outlined text-base text-red-500">location_on</span>
                <span>Vị trí</span>
            </button>
            <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-xs font-semibold text-gray-600 hover:bg-gray-50 active:scale-95 transition-all">
                <span class="material-symbols-outlined text-base text-amber-500">mood</span>
                <span>Cảm xúc</span>
            </button>
        </div>

        <!-- Chân trang chứa các nút Hành động -->
        <div class="p-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-2">
            <a asp-action="Index" class="px-4 py-2 bg-white border border-gray-200 hover:bg-gray-50 rounded-lg text-xs font-bold text-gray-600 transition-colors">
                Hủy tác vụ
            </a>
            <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-lg shadow-sm transition-all flex items-center gap-1">
                <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1">send</span>
                <span>Đăng bài viết</span>
            </button>
        </div>

    </form>
</div>

<script>
    // Xử lý xem trước hình ảnh thời gian thực
    function previewImage(event) {
    const input = event.target;
    const wrapper = document.getElementById('preview-wrapper');
    const preview = document.getElementById('image-preview');
        
    if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
    preview.src = e.target.result;
    wrapper.classList.remove('hidden');
    }
    reader.readAsDataURL(input.files[0]);
    }
    }

    // Gỡ bỏ tệp tin ảnh đang chọn
    function clearImagePreview(event) {
    event.preventDefault();
    const input = document.getElementById('imageFile');
    const wrapper = document.getElementById('preview-wrapper');
    const preview = document.getElementById('image-preview');
        
    input.value = "";
    preview.src = "#";
    wrapper.classList.add('hidden');
    }
</script>