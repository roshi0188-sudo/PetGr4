@model PetSocial.ViewModels.LoginVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - PetSocial</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>

    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        'pet-primary': '#FF6B00',
        'pet-primary-hover': '#E55A00',
        }
        }
        }
        }
    </script>
    <style>
        body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-200/60 max-w-md w-full p-8 sm:p-10">

        <div class="text-center mb-8">
            <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight">Đăng nhập</h3>
            <p class="text-xs font-semibold text-slate-400 mt-1.5 uppercase tracking-wider">Chào mừng bạn quay trở lại</p>
        </div>

        <form asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]" class="space-y-5 m-0">

            <div asp-validation-summary="ModelOnly" class="text-xs font-bold text-rose-600 bg-rose-50 px-4 py-2.5 rounded-xl border border-rose-100"></div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Tên tài khoản hoặc Email</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                        <i class="fa-regular fa-user text-sm"></i>
                    </span>
                    <input asp-for="Email" type="text" required
                           class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm placeholder-slate-400 focus:outline-none focus:bg-white focus:border-pet-primary focus:ring-1 focus:ring-pet-primary transition-all duration-150"/>
                </div>
                <span asp-validation-for="Email" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-xs font-black text-slate-700 uppercase tracking-wider">Mật khẩu</label>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="text-xs font-bold text-slate-400 hover:text-pet-primary transition-colors">Quên mật khẩu?</a>
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                        <i class="fa-solid fa-lock text-sm"></i>
                    </span>
                    <input asp-for="Password" type="password" required
                           class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm placeholder-slate-400 focus:outline-none focus:bg-white focus:border-pet-primary focus:ring-1 focus:ring-pet-primary transition-all duration-150"/>
                </div>
                <span asp-validation-for="Password" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div class="flex items-center">
                <input asp-for="RememberMe" type="checkbox"
                       class="h-4 w-4 rounded border-slate-300 text-pet-primary focus:ring-pet-primary cursor-pointer" />
                <label asp-for="RememberMe" class="ml-2 block text-xs font-bold text-slate-500 select-none cursor-pointer">
                    Nhớ mật khẩu trên thiết bị này
                </label>
            </div>

            <div class="pt-2">
                <button type="submit"
                        class="w-full py-3 px-4 bg-pet-primary hover:bg-pet-primary-hover text-white text-sm font-bold rounded-xl shadow-md shadow-orange-500/5 active:scale-[0.99] transition-all duration-150">
                    Đăng Nhập
                </button>
            </div>

            <div class="text-center mt-6 text-xs font-medium text-slate-500">
                Bạn chưa có tài khoản?
                <a asp-action="Register" class="font-extrabold text-pet-primary hover:underline ml-1">Tạo tài khoản mới</a>
            </div>

        </form>
    </div>

</body>
</html>