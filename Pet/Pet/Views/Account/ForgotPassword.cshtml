@model PetSocial.ViewModels.ForgotPasswordVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Quên mật khẩu - PetSocial</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 font-['Plus_Jakarta_Sans']">

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-200/60 max-w-md w-full p-8 sm:p-10">
        <div class="text-center mb-8">
            <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight">Khôi phục mật khẩu</h3>
            <p class="text-xs font-semibold text-slate-400 mt-1.5 uppercase tracking-wider">Nhập email để nhận liên kết xác thực</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-xl text-xs font-bold">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (ViewBag.ResetLink != null)
        {
            <div class="mb-5 p-4 bg-amber-50 text-amber-800 border border-amber-100 rounded-xl text-xs">
                <p class="font-bold mb-1"><i class="fa-solid fa-code me-1"></i> [Link giả lập gửi về Email]:</p>
                <a href="@ViewBag.ResetLink" class="text-blue-600 font-extrabold break-all underline">Bấm vào đây để đổi mật khẩu nhanh</a>
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="space-y-5 m-0">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Địa chỉ Email đăng ký</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" type="email" required class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-[#FF6B00] focus:ring-1 focus:ring-[#FF6B00]" />
                </div>
                <span asp-validation-for="Email" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <button type="submit" class="w-full py-3 bg-[#FF6B00] hover:bg-[#E55A00] text-white text-sm font-bold rounded-xl transition-all">Gửi yêu cầu xác nhận</button>

            <div class="text-center mt-6 text-xs font-medium text-slate-500">
                <a asp-action="Login" class="font-extrabold text-[#FF6B00] hover:underline"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại Đăng nhập</a>
            </div>
        </form>
    </div>

</body>
</html>