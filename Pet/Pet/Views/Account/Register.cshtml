@model PetSocial.ViewModels.RegisterVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - PetGr4</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>

    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        'pet-primary': '#FF6B00',
        'pet-primary-hover': '#E55A00',
        }
        }
        }
        }
    </script>
    <style>
        body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-200/60 max-w-md w-full p-8 sm:p-10 my-6">

        <div class="text-center mb-6">
            <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight">Tạo tài khoản mới</h3>
            <p class="text-xs font-semibold text-slate-400 mt-1.5 uppercase tracking-wider">Gia nhập cộng đồng PetGr4</p>
        </div>

        <form asp-action="Register" method="post" class="space-y-4 m-0">

            <div asp-validation-summary="ModelOnly" class="text-xs font-bold text-rose-600 bg-rose-50 px-4 py-2.5 rounded-xl border border-rose-100"></div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-1.5">Họ và tên</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                        <i class="fa-regular fa-id-card text-sm"></i>
                    </span>
                    <input asp-for="FullName" type="text" required
                           class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-pet-primary focus:ring-1 focus:ring-pet-primary transition-all duration-150" />
                </div>
                <span asp-validation-for="FullName" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-1.5">Địa chỉ Email</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                        <i class="fa-regular fa-envelope text-sm"></i>
                    </span>
                    <input asp-for="Email" type="email" required
                           class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-pet-primary focus:ring-1 focus:ring-pet-primary transition-all duration-150" />
                </div>
                <span asp-validation-for="Email" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-1.5">Số điện thoại</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                        <i class="fa-solid fa-phone text-sm"></i>
                    </span>
                    <input asp-for="PhoneNumber" type="tel" required
                           class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-pet-primary focus:ring-1 focus:ring-pet-primary transition-all duration-150" />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-1.5">Mật khẩu</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                        <i class="fa-solid fa-lock text-sm"></i>
                    </span>
                    <input asp-for="Password" type="password" required
                           class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-pet-primary focus:ring-1 focus:ring-pet-primary transition-all duration-150" />
                </div>
                <span asp-validation-for="Password" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-1.5">Xác nhận mật khẩu</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                        <i class="fa-solid fa-shield text-sm"></i>
                    </span>
                    <input asp-for="ConfirmPassword" type="password" required
                           class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-pet-primary focus:ring-1 focus:ring-pet-primary transition-all duration-150" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div class="pt-3">
                <button type="submit"
                        class="w-full py-3 px-4 bg-pet-primary hover:bg-pet-primary-hover text-white text-sm font-bold rounded-xl shadow-md shadow-orange-500/5 active:scale-[0.99] transition-all duration-150 flex items-center justify-center gap-2">
                    Đăng Ký <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </div>

            <div class="text-center mt-6 text-xs font-medium text-slate-500">
                Bạn đã có tài khoản?
                <a asp-action="Login" class="font-extrabold text-pet-primary hover:underline ml-1">Đăng nhập ngay</a>
            </div>

        </form>

        <p class="text-center text-slate-400 mt-8 font-medium leading-relaxed" style="font-size: 0.7rem;">
            Bằng việc đăng ký, bạn đồng ý với <a href="#" class="hover:underline text-slate-500">Điều khoản dịch vụ</a> và <a href="#" class="hover:underline text-slate-500">Chính sách bảo mật</a> của chúng tôi.
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
