@model PetSocial.ViewModels.ResetPasswordVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đặt lại mật khẩu - PetSocial</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 font-['Plus_Jakarta_Sans']">

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-200/60 max-w-md w-full p-8 sm:p-10">
        <div class="text-center mb-6">
            <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight">Thiết lập mật khẩu</h3>
            <p class="text-xs font-semibold text-slate-400 mt-1.5 uppercase tracking-wider">Vui lòng nhập mật khẩu bảo mật mới</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="space-y-4 m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="text-xs font-bold text-rose-600 bg-rose-50 px-4 py-2 rounded-xl"></div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Mật khẩu mới</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password" type="password" required class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-[#FF6B00] focus:ring-1 focus:ring-[#FF6B00]" />
                </div>
                <span asp-validation-for="Password" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Xác nhận mật khẩu</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400"><i class="fa-solid fa-shield-halved"></i></span>
                    <input asp-for="ConfirmPassword" type="password" required class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:bg-white focus:border-[#FF6B00] focus:ring-1 focus:ring-[#FF6B00]" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-xs font-semibold text-rose-500 mt-1 block"></span>
            </div>

            <button type="submit" class="w-full py-3 bg-[#FF6B00] hover:bg-[#E55A00] text-white text-sm font-bold rounded-xl transition-all pt-2.5">Cập nhật mật khẩu mới</button>
        </form>
    </div>

</body>
</html>