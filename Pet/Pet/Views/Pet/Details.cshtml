@using System.Text.Json
@model PetSocial.Models.PetModule

@{
    ViewData["Title"] = Model.Name;
    ViewData["FullWidth"] = true;

    var imageUrl = string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/images/logo.jpg") : Url.Content(Model.AvatarUrl);
    var breed = string.IsNullOrWhiteSpace(Model.Breed) ? Model.Species : Model.Breed;
    var gender = string.IsNullOrWhiteSpace(Model.Gender) ? "Chưa cập nhật" : Model.Gender;
    var personality = string.IsNullOrWhiteSpace(Model.Personality) ? "Thân thiện" : Model.Personality;
    var hasLocation = !string.IsNullOrWhiteSpace(Model.Location);
    var location = hasLocation ? Model.Location! : "Chưa cập nhật";
    var mapQueryText = hasLocation && location.Contains("Việt Nam", StringComparison.OrdinalIgnoreCase) ? location : $"{location}, Việt Nam";
    var mapQuery = hasLocation ? System.Net.WebUtility.UrlEncode(mapQueryText) : string.Empty;
    var mapUrl = hasLocation ? $"https://www.google.com/maps?q={mapQuery}&z=17&output=embed" : string.Empty;
    var mapLink = hasLocation ? $"https://www.google.com/maps/search/?api=1&query={mapQuery}" : "#";
    var canManagePet = ViewBag.CanManagePet as bool? ?? false;
    ViewData["ActiveMenu"] = canManagePet ? "MyPets" : "PetDirectory";
    var ownerName = !string.IsNullOrWhiteSpace(Model.User?.FullName) ? Model.User.FullName : Model.User?.Email ?? Model.User?.UserName ?? "PetSocial";
    var ownerAvatarUrl = string.IsNullOrWhiteSpace(Model.User?.AvatarUrl) ? Url.Content("~/images/logo.jpg") : Url.Content(Model.User.AvatarUrl);
    var backAction = canManagePet ? "MyPets" : "Index";
    var nearbyPets = ViewBag.NearbyPets as IEnumerable<PetSocial.Models.PetModule> ?? Enumerable.Empty<PetSocial.Models.PetModule>();
    var nearbyPetData = nearbyPets.Select((pet, index) => new
    {
        pet.Id,
        Name = pet.Name,
        Species = pet.Species,
        Location = pet.Location,
        Url = Url.Action("Details", "Pet", new { id = pet.Id }),
        MarkerClass = (pet.Species ?? "").Contains("mèo", StringComparison.OrdinalIgnoreCase) || (pet.Species ?? "").Contains("meo", StringComparison.OrdinalIgnoreCase) ? "cat" : "dog",
        Top = 18 + (index % 3) * 22,
        Left = 16 + (index * 17 % 68)
    }).ToList();
}

<section class="pet-page pet-detail-page">
    <div class="pet-main pet-detail-main">
        <div class="pet-detail-header">
            <a asp-action="@backAction" class="pet-detail-back"><i class="fa fa-arrow-left"></i> Quay lại</a>
            @if (canManagePet)
            {
                <div class="pet-detail-actions">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="pet-detail-edit"><i class="fa fa-pencil"></i> Sửa</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="pet-detail-delete"><i class="fa fa-trash"></i> Xóa</a>
                </div>
            }
        </div>

        <div class="pet-detail-shell">
            <div class="pet-detail-photo-card">
                <img src="@imageUrl" alt="Ảnh của @Model.Name" />
                <span class="pet-detail-status"><i class="fa fa-check-circle"></i> Hồ sơ đang hoạt động</span>
            </div>

            <div class="pet-detail-right">
                <div class="pet-detail-hero-card">
                    <div class="pet-detail-title">
                        <span class="pet-detail-eyebrow"><i class="fa fa-paw"></i> @Model.Species</span>
                        <h1>@Model.Name</h1>
                        <p class="pet-detail-meta">
                            <span><i class="fa fa-star"></i> @breed</span>
                            <span><i class="fa fa-birthday-cake"></i> @Model.Age tuổi</span>
                        </p>
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" class="pet-detail-owner-line">
                            <img src="@ownerAvatarUrl" alt="Ảnh đại diện của @ownerName" />
                            <span>Người đăng: <strong>@ownerName</strong></span>
                        </a>
                        <p class="pet-detail-location-line"><i class="fa fa-map-marker"></i> @location</p>
                    </div>
                    @if (!canManagePet)
                    {
                        <a asp-controller="Match"
                           asp-action="Index"
                           asp-route-communityPetId="@Model.Id"
                           class="pet-detail-connect">
                            <i class="fa fa-heart"></i>
                            Kết nối
                        </a>
                    }
                </div>

                <div class="pet-detail-content">
                    <div class="pet-detail-tags">
                        <span><i class="fa fa-tag"></i> #@personality.Replace(" ", "")</span>
                        <span><i class="fa fa-tag"></i> #@breed.Replace(" ", "")</span>
                        <span><i class="fa fa-tag"></i> #@Model.Age tuổi</span>
                    </div>

                    <div class="pet-detail-stats">
                        <div><i class="fa fa-paw"></i><small>Loại</small><strong>@Model.Species</strong></div>
                        <div><i class="fa fa-venus-mars"></i><small>Giới tính</small><strong>@gender</strong></div>
                        <div><i class="fa fa-balance-scale"></i><small>Cân nặng</small><strong>@(Model.Weight.HasValue ? $"{Model.Weight:0.#} kg" : "Chưa cập nhật")</strong></div>
                    </div>

                    <div class="pet-detail-info-grid">
                        <article><h2><i class="fa fa-paint-brush"></i> Màu lông</h2><p>@(string.IsNullOrWhiteSpace(Model.FurColor) ? "Chưa cập nhật" : Model.FurColor)</p></article>
                        <article><h2><i class="fa fa-heart"></i> Tính cách</h2><p>@personality</p></article>
                        <article><h2><i class="fa fa-gamepad"></i> Sở thích</h2><p>@(string.IsNullOrWhiteSpace(Model.Hobbies) ? "Chưa cập nhật" : Model.Hobbies)</p></article>
                        <article><h2><i class="fa fa-map-marker"></i> Vị trí/khu vực</h2><p>@location</p></article>
                        <article class="wide"><h2><i class="fa fa-align-left"></i> Mô tả thêm</h2><p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả thêm." : Model.Description)</p></article>

                        @if (hasLocation)
                        {
                            <article class="wide pet-detail-map-card" data-pet-map data-location="@location">
                                <div class="pet-detail-map-heading">
                                    <h2><i class="fa fa-map"></i> Bản đồ vị trí</h2>
                                    <a href="@mapLink" target="_blank" rel="noopener noreferrer" data-pet-map-link><i class="fa fa-external-link"></i> Mở bản đồ</a>
                                </div>
                                <div class="pet-map-frame-wrap">
                                    <iframe data-pet-map-frame
                                            src="@mapUrl"
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            title="Bản đồ vị trí @Model.Name">
                                    </iframe>
                                    <span class="pet-map-paw-marker" title="Vị trí của @Model.Name">
                                        <i class="fa fa-paw"></i>
                                    </span>

                                    @if (nearbyPetData.Any())
                                    {
                                        <div class="pet-nearby-map-layer" aria-label="Thú cưng gần đây trên bản đồ">
                                            @foreach (var item in nearbyPetData)
                                            {
                                                <a href="@item.Url"
                                                   class="pet-nearby-marker @item.MarkerClass"
                                                   style="--marker-top:@item.Top%;--marker-left:@item.Left%;"
                                                   title="@item.Name - @item.Location">
                                                    <i class="fa @(item.MarkerClass == "cat" ? "fa-github-alt" : "fa-paw")"></i>
                                                    <span>@item.Name</span>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (nearbyPetData.Any())
                                {
                                    <div class="pet-nearby-list">
                                        <strong>Thú cưng gần đây</strong>
                                        <div>
                                            @foreach (var item in nearbyPetData.Take(5))
                                            {
                                                <a href="@item.Url">
                                                    <i class="fa @(item.MarkerClass == "cat" ? "fa-github-alt" : "fa-paw")"></i>
                                                    @item.Name
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const mapCard = document.querySelector('[data-pet-map]');
            if (!mapCard) return;

            const locationText = mapCard.dataset.location;
            const frame = mapCard.querySelector('[data-pet-map-frame]');
            const link = mapCard.querySelector('[data-pet-map-link]');
            if (!locationText || !frame || !link) return;

            const normalizeMapQuery = value => {
                const text = (value || '').trim();
                if (!text) return '';
                return /việt nam|viet nam/i.test(text) ? text : `${text}, Việt Nam`;
            };

            const getCoordsFromText = value => {
                const match = value.match(/^\s*(-?\d+(?:[.,]\d+)?)\s*,\s*(-?\d+(?:[.,]\d+)?)\s*$/);
                if (!match) return null;

                return {
                    lat: match[1].replace(',', '.'),
                    lng: match[2].replace(',', '.')
                };
            };

            const setMapPosition = ({ lat, lng }) => {
                const query = `${lat},${lng}`;
                frame.src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&z=18&output=embed`;
                link.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
            };

            const setMapByAddress = value => {
                const query = normalizeMapQuery(value);
                if (!query) return;
                frame.src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&z=17&output=embed`;
                link.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
            };

            const geocodeLocation = async () => {
                const coords = getCoordsFromText(locationText);
                if (coords) {
                    setMapPosition(coords);
                    return;
                }

                try {
                    const query = normalizeMapQuery(locationText);
                    const url = `https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&addressdetails=1&accept-language=vi&q=${encodeURIComponent(query)}`;
                    const response = await fetch(url);
                    if (!response.ok) {
                        setMapByAddress(locationText);
                        return;
                    }

                    const results = await response.json();
                    if (!results.length) {
                        setMapByAddress(locationText);
                        return;
                    }

                    setMapPosition({ lat: results[0].lat, lng: results[0].lon });
                } catch {
                    setMapByAddress(locationText);
                }
            };

            geocodeLocation();
        })();
    </script>
}
