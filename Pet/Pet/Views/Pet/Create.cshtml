@model PetSocial.Models.PetModule

@{
    ViewData["Title"] = "Thêm thú cưng";
    ViewData["FullWidth"] = true;
    ViewData["ActiveMenu"] = "Pet";
}

<section class="pet-page pet-create-page">
    <div class="pet-main pet-create-main">
        <div class="pet-create-header">
            <div>
                <span class="pet-create-eyebrow">Tạo hồ sơ mới</span>
                <h1>Thêm thú cưng</h1>
                <p>Nhập thông tin chi tiết để hồ sơ hiển thị đầy đủ trên danh sách và trang chi tiết.</p>
            </div>
            <a asp-action="Index" class="pet-create-back"><i class="fa fa-arrow-left"></i> Quay lại</a>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="pet-create-form">
            <div class="pet-create-upload">
                <div class="pet-upload-preview" id="petUploadPlaceholder">
                    <i class="fa fa-paw"></i>
                    <img id="petImagePreview" alt="Ảnh thú cưng đã chọn" hidden />
                </div>
                <h2>Ảnh thú cưng</h2>
                <p>Chọn ảnh rõ mặt để hồ sơ nổi bật hơn.</p>
                <label class="pet-upload-button">
                    <i class="fa fa-cloud-upload"></i>
                    Chọn ảnh
                    <input type="file" name="imageFile" accept="image/*" data-preview-target="petImagePreview" data-hide-target="petUploadPlaceholder" />
                </label>
            </div>

            <div class="pet-create-card">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="pet-create-grid">
                    <div class="pet-create-field"><label asp-for="Name">Tên thú cưng</label><input asp-for="Name" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                    <div class="pet-create-field"><label asp-for="Species">Loài thú cưng</label><input asp-for="Species" placeholder="Chó, Mèo..." /></div>
                    <div class="pet-create-field"><label asp-for="Breed">Giống thú cưng</label><input asp-for="Breed" /></div>
                    <div class="pet-create-field"><label asp-for="Age">Tuổi</label><input asp-for="Age" type="number" min="0" /></div>
                    <div class="pet-create-field">
                        <label asp-for="Gender">Giới tính</label>
                        <select asp-for="Gender"><option value="">Chọn giới tính</option><option>Đực</option><option>Cái</option></select>
                    </div>
                    <div class="pet-create-field"><label asp-for="FurColor">Màu lông</label><input asp-for="FurColor" /></div>
                    <div class="pet-create-field"><label for="Weight">Cân nặng</label><input id="Weight" name="Weight" type="text" inputmode="decimal" value="@Model.Weight?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" placeholder="Ví dụ: 4.5 kg" /></div>
                    <div class="pet-create-field"><label asp-for="Personality">Tính cách</label><input asp-for="Personality" placeholder="Năng động, dễ thương..." /></div>
                    <div class="pet-create-field"><label asp-for="Hobbies">Sở thích</label><input asp-for="Hobbies" /></div>
                    <div class="pet-create-field pet-location-field">
                        <label asp-for="Location">Vị trí/khu vực</label>
                        <div class="pet-location-control">
                            <input asp-for="Location" data-location-input placeholder="Ví dụ: Bình Thạnh, TP.HCM hoặc tọa độ hiện tại" />
                            <button type="button" class="pet-use-location" data-use-current-location>
                                <i class="fa fa-location-arrow"></i>
                                Dùng vị trí hiện tại
                            </button>
                        </div>
                        <small data-location-status></small>
                        <div class="pet-location-map" data-location-map hidden>
                            <iframe data-location-map-frame title="Bản đồ vị trí thú cưng" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                    <div class="pet-create-field full"><label asp-for="Description">Mô tả thêm</label><textarea asp-for="Description" rows="5"></textarea></div>
                </div>

                <div class="pet-create-note"><i class="fa fa-heart"></i> Lưu hồ sơ để thông tin hiển thị trên trang danh sách và trang chi tiết.</div>
                <div class="pet-create-actions">
                    <a asp-action="Index" class="pet-create-cancel">Hủy</a>
                    <button type="submit" class="pet-create-submit"><i class="fa fa-save"></i> Lưu hồ sơ</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('[data-preview-target="petImagePreview"]')?.addEventListener('change', function () {
            const file = this.files && this.files[0];
            const preview = document.getElementById(this.dataset.previewTarget);
            const holder = document.getElementById(this.dataset.hideTarget);
            if (!file || !preview) return;
            preview.hidden = false;
            holder?.classList.add('has-preview');
            preview.src = URL.createObjectURL(file);
            preview.onload = () => URL.revokeObjectURL(preview.src);
        });

        document.querySelector('[data-use-current-location-old]')?.addEventListener('click', function () {
            const input = document.querySelector('[data-location-input]');
            const status = document.querySelector('[data-location-status]');
            if (!navigator.geolocation) {
                if (status) status.textContent = 'Trình duyệt không hỗ trợ định vị.';
                return;
            }

            this.disabled = true;
            if (status) status.textContent = 'Đang lấy vị trí hiện tại...';

            navigator.geolocation.getCurrentPosition(
                position => {
                    const lat = position.coords.latitude.toFixed(6);
                    const lng = position.coords.longitude.toFixed(6);
                    if (input) input.value = `${lat}, ${lng}`;
                    if (status) status.textContent = 'Đã lấy vị trí hiện tại.';
                    this.disabled = false;
                },
                () => {
                    if (status) status.textContent = 'Không thể lấy vị trí. Hãy cho phép quyền định vị hoặc nhập thủ công.';
                    this.disabled = false;
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        });

        const showLocationMap = (lat, lng) => {
            const map = document.querySelector('[data-location-map]');
            const frame = document.querySelector('[data-location-map-frame]');
            if (!map || !frame) return;
            frame.src = `https://www.google.com/maps?q=${encodeURIComponent(`${lat},${lng}`)}&output=embed`;
            map.hidden = false;
        };

        const getAddressFromCoords = async (lat, lng) => {
            const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&accept-language=vi`;
            const response = await fetch(url);
            if (!response.ok) throw new Error('Không thể lấy địa chỉ');
            const data = await response.json();
            return data.display_name || '';
        };

        document.querySelector('[data-use-current-location]')?.addEventListener('click', async function () {
            const input = document.querySelector('[data-location-input]');
            const status = document.querySelector('[data-location-status]');

            if (!navigator.geolocation) {
                if (status) status.textContent = 'Trình duyệt không hỗ trợ định vị.';
                return;
            }

            this.disabled = true;
            if (status) status.textContent = 'Đang lấy vị trí hiện tại...';

            navigator.geolocation.getCurrentPosition(
                async position => {
                    const lat = position.coords.latitude.toFixed(6);
                    const lng = position.coords.longitude.toFixed(6);
                    showLocationMap(lat, lng);

                    try {
                        if (status) status.textContent = 'Đang chuyển tọa độ thành địa chỉ...';
                        const address = await getAddressFromCoords(lat, lng);
                        if (input) input.value = address || `${lat}, ${lng}`;
                        if (status) status.textContent = address ? 'Đã lấy địa chỉ hiện tại và hiển thị bản đồ.' : 'Đã lấy tọa độ hiện tại và hiển thị bản đồ.';
                    } catch {
                        if (input) input.value = `${lat}, ${lng}`;
                        if (status) status.textContent = 'Đã hiển thị bản đồ. Không thể đổi thành địa chỉ, bạn có thể nhập lại thủ công.';
                    }

                    this.disabled = false;
                },
                () => {
                    if (status) status.textContent = 'Không thể lấy vị trí. Hãy cho phép quyền định vị hoặc nhập thủ công.';
                    this.disabled = false;
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        });
    </script>
}