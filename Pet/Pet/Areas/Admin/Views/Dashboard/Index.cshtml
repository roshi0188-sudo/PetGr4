@model PetSocial.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<style>
    :root {
        --pet-orange: #ff7e21;
        --pet-orange-hover: #e66e1c;
        --bg-light: #f8fafc;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-light);
    }

    /* Khắc phục lỗi thanh điều hướng dính sát mép */
    .dashboard-wrapper {
        display: flex;
        min-height: 100vh;
    }

    .admin-sidebar {
        width: 260px;
        background: #ffffff;
        border-right: 1px solid #e2e8f0;
        flex-shrink: 0;
        padding: 24px 16px;
    }

    .main-content {
        flex-grow: 1;
        padding: 40px;
        background-color: var(--bg-light);
        overflow-y: auto;
    }

    /* Định dạng menu điều hướng */
    .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-left: 12px;
        margin-bottom: 40px;
    }

    .nav-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-menu-item {
        margin-bottom: 8px;
    }

    .nav-menu-link {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        color: #64748b;
        text-decoration: none;
        font-weight: 500;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

        .nav-menu-link:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

        .nav-menu-link.active {
            background-color: #ffedd5;
            color: var(--pet-orange);
            font-weight: 600;
        }

    /* Thẻ hiển thị thông số */
    .admin-header {
        background: white;
        padding: 24px;
        border-radius: 20px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
        margin-bottom: 32px;
    }

    .stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.01);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.04);
        }

    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .card-footer-action {
        background: #fafafa;
        border-top: 1px solid #f1f5f9;
        padding: 12px 20px;
    }

    .card-footer-link {
        text-decoration: none;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 500;
    }

        .card-footer-link:hover {
            color: var(--pet-orange);
        }

    /* Định dạng bảng danh sách */
    .table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
    }

    .badge-active {
        background-color: #dcfce7;
        color: #166534;
    }

    .badge-suspended {
        background-color: #fee2e2;
        color: #991b1b;
    }
</style>

<div class="dashboard-wrapper">  
    <main class="main-content">
        <div class="admin-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Chào mừng quay lại, Quản trị viên!</h1>
                <p class="text-muted mb-0">Dưới đây là tổng quan về hoạt động của mạng xã hội PetSocial.</p>
            </div>
            <div class="display-6"></div>
        </div>

        <h5 class="mb-3 fw-bold text-secondary">Thông số cốt lõi</h5>
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-bold mb-1">TỔNG NGƯỜI DÙNG</div>
                                <div class="h2 fw-bold mb-0 text-dark">@Model.TotalUsers</div>
                            </div>
                            <div class="icon-box bg-primary bg-opacity-10 text-primary">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-action d-flex justify-content-between align-items-center">
                        <a href="#" class="card-footer-link">Quản lý người dùng</a>
                        <i class="fas fa-angle-right text-muted small"></i>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-bold mb-1">TỔNG THÚ CƯNG</div>
                                <div class="h2 fw-bold mb-0 text-dark">@Model.TotalPets</div>
                            </div>
                            <div class="icon-box bg-warning bg-opacity-10 text-warning">
                                <i class="fas fa-paw"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-action d-flex justify-content-between align-items-center">
                        <a asp-area="" asp-controller="Pet" asp-action="Index" class="card-footer-link">Kiểm duyệt thú cưng</a>
                        <i class="fas fa-angle-right text-muted small"></i>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-bold mb-1">TỔNG BÀI VIẾT</div>
                                <div class="h2 fw-bold mb-0 text-dark">@Model.TotalPosts</div>
                            </div>
                            <div class="icon-box bg-success bg-opacity-10 text-success">
                                <i class="fas fa-file-alt"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-action d-flex justify-content-between align-items-center">
                        <a href="#" class="card-footer-link">Quản lý nội dung</a>
                        <i class="fas fa-angle-right text-muted small"></i>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-bold mb-1">TỔNG BÌNH LUẬN</div>
                                <div class="h2 fw-bold mb-0 text-dark">@Model.TotalComments</div>
                            </div>
                            <div class="icon-box bg-info bg-opacity-10 text-info">
                                <i class="fas fa-comments"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-action d-flex justify-content-between align-items-center">
                        <a href="#" class="card-footer-link">Xem chi tiết</a>
                        <i class="fas fa-angle-right text-muted small"></i>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mt-4 mb-3 fw-bold text-secondary">❤️ Tương tác & Tin nhắn</h5>
        <div class="row mb-5">
            <div class="col-md-6 mb-4">
                <div class="card stat-card shadow-sm border-0">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="icon-box bg-danger bg-opacity-10 text-danger fs-2" style="width: 64px; height: 64px; border-radius: 16px;">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-bold">TỔNG LƯỢT THÍCH</div>
                            <div class="h1 fw-bold mb-0 text-dark">@Model.TotalLikes</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card stat-card shadow-sm border-0">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="icon-box bg-warning bg-opacity-10 text-warning fs-2" style="width: 64px; height: 64px; border-radius: 16px;">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-bold">TỔNG TIN NHẮN CHAT</div>
                            <div class="h1 fw-bold mb-0 text-dark">@Model.TotalMessages</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-secondary mb-0">Quản lý người dùng</h5>
            <button class="btn btn-dark btn-sm rounded-pill px-3" style="background-color: var(--pet-orange); border: none;"><i class="fas fa-plus me-2"></i>Thêm Admin</button>
        </div>

        <div class="card table-card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondarysmall">
                        <tr>
                            <th class="ps-4 py-3">USER</th>
                            <th class="py-3">JOIN DATE</th>
                            <th class="py-3">PETS</th>
                            <th class="py-3">POSTS</th>
                            <th class="py-3">ROLE</th>
                            <th class="py-3">STATUS</th>
                            <th class="text-end pe-4 py-3">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users != null)
                        {
                            foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@user.FullName</div>
                                                <small class="text-muted">@user.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="text-muted">@user.JoinDate.ToString("MMM dd, yyyy")</span></td>
                                    <td><span class="badge bg-light text-dark border px-2 py-1">@user.PetCount Pets</span></td>
                                    <td class="fw-semibold text-dark">@user.PostCount</td>
                                    <td><span class="text-secondary fw-medium">@user.Role</span></td>
                                    <td>
                                        <span class="badge px-2 py-1 @(user.IsActive ? "badge-active" : "badge-suspended")">
                                            ● @(user.IsActive ? "Active" : "Suspended")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-light text-primary me-1 rounded-circle"><i class="fas fa-eye"></i></button>
                                        <button class="btn btn-sm btn-light text-warning rounded-circle"><i class="fas fa-edit"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu hiển thị</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>