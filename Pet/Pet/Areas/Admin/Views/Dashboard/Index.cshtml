@model PetSocial.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Bảng điều khiển Tổng quan";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
    --pet-orange: #ff7e21;
    --pet-orange-hover: #e66e1c;
    --bg-light: #f8fafc;
    }

    body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: var(--bg-light);
    }

    .main-content {
    flex-grow: 1;
    padding: 40px;
    background-color: var(--bg-light);
    overflow-x: hidden;
    }

    .admin-header {
    background: white;
    padding: 24px 32px;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(21, 28, 39, 0.02);
    margin-bottom: 32px;
    border: 1px solid #e2e8f0;
    }

    .stat-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(21, 28, 39, 0.02);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    }

    .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04);
    }

    .icon-box {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    }

    .card-footer-action {
    background: #f8fafc;
    border-top: 1px solid #f1f5f9;
    padding: 14px 24px;
    margin-top: auto;
    }

    .card-footer-link {
    text-decoration: none;
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 700;
    transition: color 0.2s;
    }

    .card-footer-link:hover {
    color: var(--pet-orange);
    }

    .chart-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(21, 28, 39, 0.02);
    display: flex;
    flex-direction: column;
    height: 100%;
    }
</style>

<div class="main-content">
    <div style="max-width: 1300px; margin: 0 auto; width: 100%;">

        <div class="admin-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-extrabold text-dark mb-1" style="font-weight: 800; letter-spacing: -0.5px;">Trung tâm điều khiển</h1>
                <p class="text-muted mb-0 small font-medium">Theo dõi dữ liệu và luồng tương tác mạng xã hội PetSocial theo thời gian thực.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-md-block">
                    <div class="fw-bold text-dark" style="font-size: 0.9rem;">Admin Hệ thống</div>
                    <div class="text-success small fw-bold"><i class="fa-solid fa-circle text-[8px] me-1"></i>Đang trực tuyến</div>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: #fff3eb; color: var(--pet-orange); width: 48px; height: 48px;">
                    <i class="fa-solid fa-bolt fs-5"></i>
                </div>
            </div>
        </div>

        <h5 class="mb-4 fw-bold text-secondary text-uppercase tracking-wider" style="font-size: 0.8rem; letter-spacing: 1px;">Chỉ số hệ thống lõi</h5>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-bottom: 40px;">

            <div class="card stat-card border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted fw-bold mb-2 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tổng người dùng</div>
                            <div class="h2 fw-black mb-0 text-dark" style="font-weight: 900;">@Model.TotalUsers</div>
                        </div>
                        <div class="icon-box" style="background: #eff6ff; color: #3b82f6;">
                            <i class="fa-solid fa-users"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer-action d-flex justify-content-between align-items-center">
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="card-footer-link">Quản lý thành viên</a>
                    <i class="fa-solid fa-arrow-right text-muted small"></i>
                </div>
            </div>

            <div class="card stat-card border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted fw-bold mb-2 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tổng thú cưng</div>
                            <div class="h2 fw-black mb-0 text-dark" style="font-weight: 900;">@Model.TotalPets</div>
                        </div>
                        <div class="icon-box" style="background: #fffbeb; color: #f59e0b;">
                            <i class="fa-solid fa-paw"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer-action d-flex justify-content-between align-items-center">
                    <a asp-area="" asp-controller="Pet" asp-action="Index" class="card-footer-link">Kiểm duyệt hồ sơ</a>
                    <i class="fa-solid fa-arrow-right text-muted small"></i>
                </div>
            </div>

            <div class="card stat-card border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted fw-bold mb-2 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tổng bài đăng</div>
                            <div class="h2 fw-black mb-0 text-dark" style="font-weight: 900;">@Model.TotalPosts</div>
                        </div>
                        <div class="icon-box" style="background: #f0fdf4; color: #22c55e;">
                            <i class="fa-solid fa-images"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer-action d-flex justify-content-between align-items-center">
                    <a asp-area="" asp-controller="Post" asp-action="Community" class="card-footer-link">Quản lý nội dung</a>
                    <i class="fa-solid fa-arrow-right text-muted small"></i>
                </div>
            </div>

            <div class="card stat-card border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted fw-bold mb-2 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Lượt tương tác</div>
                            <div class="h2 fw-black mb-0 text-dark" style="font-weight: 900;">@((Model.TotalLikes + Model.TotalComments))</div>
                        </div>
                        <div class="icon-box" style="background: #fef2f2; color: #ef4444;">
                            <i class="fa-solid fa-heart"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer-action d-flex justify-content-between align-items-center">
                    <span class="text-muted small font-bold">Thích & Bình luận</span>
                    <i class="fa-solid fa-chart-line text-danger small"></i>
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 24px; margin-bottom: 40px;">

            <div class="chart-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="fw-bold text-dark mb-0">Xu hướng 7 ngày qua</h6>
                    <span class="badge bg-light text-muted border">Hàng tuần</span>
                </div>
                <div style="position: relative; height: 320px; width: 100%;">
                    <canvas id="weeklyChart"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="fw-bold text-dark mb-0">Tăng trưởng 6 tháng gần nhất</h6>
                    <span class="badge bg-light text-muted border">Hàng tháng</span>
                </div>
                <div style="position: relative; height: 320px; width: 100%;">
                    <canvas id="monthlyChart"></canvas>
                </div>
            </div>

        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    const weeklyLabels = @Html.Raw(Json.Serialize(Model.WeeklyLabels ?? new List<string>()));
    const weeklyUsers = @Html.Raw(Json.Serialize(Model.WeeklyNewUsers ?? new List<int>()));
    const weeklyPosts = @Html.Raw(Json.Serialize(Model.WeeklyNewPosts ?? new List<int>()));

    const monthlyLabels = @Html.Raw(Json.Serialize(Model.MonthlyLabels ?? new List<string>()));
    const monthlyUsers = @Html.Raw(Json.Serialize(Model.MonthlyNewUsers ?? new List<int>()));
    const monthlyPosts = @Html.Raw(Json.Serialize(Model.MonthlyNewPosts ?? new List<int>()));

    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
    Chart.defaults.color = '#64748b';

    const ctxWeekly = document.getElementById('weeklyChart').getContext('2d');
    new Chart(ctxWeekly, {
    type: 'line',
    data: {
    labels: weeklyLabels.length > 0 ? weeklyLabels : ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
    datasets: [
    {
    label: 'Người dùng mới',
    data: weeklyUsers.length > 0 ? weeklyUsers : [0, 0, 0, 0, 0, 0, 0],
    borderColor: '#3b82f6',
    backgroundColor: 'rgba(59, 130, 246, 0.1)',
    borderWidth: 3,
    tension: 0.4,
    fill: true,
    pointBackgroundColor: '#ffffff',
    pointBorderColor: '#3b82f6',
    pointBorderWidth: 2,
    pointRadius: 4
    },
    {
    label: 'Bài viết mới',
    data: weeklyPosts.length > 0 ? weeklyPosts : [0, 0, 0, 0, 0, 0, 0],
    borderColor: '#ff7e21',
    backgroundColor: 'transparent',
    borderWidth: 3,
    tension: 0.4,
    borderDash: [5, 5],
    pointBackgroundColor: '#ffffff',
    pointBorderColor: '#ff7e21',
    pointBorderWidth: 2,
    pointRadius: 4
    }
    ]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: { position: 'top', align: 'end', labels: { usePointStyle: true, boxWidth: 8 } }
    },
    scales: {
    y: { beginAtZero: true, grid: { borderDash: [2, 4], color: '#e2e8f0' }, border: { display: false } },
    x: { grid: { display: false }, border: { display: false } }
    }
    }
    });

    const ctxMonthly = document.getElementById('monthlyChart').getContext('2d');
    new Chart(ctxMonthly, {
    type: 'bar',
    data: {
    labels: monthlyLabels.length > 0 ? monthlyLabels : ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6'],
    datasets: [
    {
    label: 'Người dùng mới',
    data: monthlyUsers.length > 0 ? monthlyUsers : [0, 0, 0, 0, 0, 0],
    backgroundColor: '#3b82f6',
    borderRadius: 6,
    barPercentage: 0.6,
    categoryPercentage: 0.8
    },
    {
    label: 'Bài viết mới',
    data: monthlyPosts.length > 0 ? monthlyPosts : [0, 0, 0, 0, 0, 0],
    backgroundColor: '#ff7e21',
    borderRadius: 6,
    barPercentage: 0.6,
    categoryPercentage: 0.8
    }
    ]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: { position: 'top', align: 'end', labels: { usePointStyle: true, boxWidth: 8 } }
    },
    scales: {
    y: { beginAtZero: true, grid: { borderDash: [2, 4], color: '#e2e8f0' }, border: { display: false } },
    x: { grid: { display: false }, border: { display: false } }
    }
    }
    });
    });
</script>