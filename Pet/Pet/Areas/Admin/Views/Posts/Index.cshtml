@model PetSocial.ViewModels.AdminPostManagementVM

@{
    ViewData["Title"] = "Quản lý bài viết";
    var maxChartValue = Math.Max(1, Model.ChartValues.DefaultIfEmpty(0).Max());
}

<style>
    .admin-page-title { font-weight: 800; color: #0f172a; }
    .metric-card, .content-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; }
    .metric-card { padding: 22px; }
    .metric-label { color: #64748b; font-size: .78rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
    .metric-value { color: #0f172a; font-size: 2rem; font-weight: 800; line-height: 1; margin-top: 8px; }
    .chart-bars { height: 220px; display: grid; grid-template-columns: repeat(7, 1fr); gap: 14px; align-items: end; padding-top: 18px; }
    .chart-bar-wrap { height: 100%; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; text-align: center; }
    .chart-bar { min-height: 8px; border-radius: 10px 10px 4px 4px; background: linear-gradient(180deg, #ff8a3d, #2563eb); }
    .post-thumb { width: 64px; height: 64px; object-fit: cover; border-radius: 12px; background: #f1f5f9; }
    .post-content-preview { max-width: 460px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="admin-page-title h3 mb-1">Quản lý bài viết</h1>
        <p class="text-muted mb-0">Theo dõi, tìm kiếm, xem chi tiết và xử lý nội dung vi phạm.</p>
    </div>
    <a asp-action="Reports" class="btn btn-warning fw-semibold">
        <i class="fas fa-flag me-2"></i>Báo cáo bài viết
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="metric-card">
            <div class="metric-label">Tổng bài viết</div>
            <div class="metric-value">@Model.TotalPosts</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="metric-card">
            <div class="metric-label">Tổng báo cáo</div>
            <div class="metric-value">@Model.TotalReports</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="metric-card">
            <div class="metric-label">Đang chờ xử lý</div>
            <div class="metric-value">@Model.PendingReports</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="metric-card">
            <div class="metric-label">Bài bị báo cáo</div>
            <div class="metric-value">@Model.ReportedPosts</div>
        </div>
    </div>
</div>

<div class="content-card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 fw-bold mb-1">Biểu đồ bài viết 7 ngày gần nhất</h2>
            <p class="text-muted small mb-0">Số bài viết mới được đăng theo ngày.</p>
        </div>
    </div>
    <div class="chart-bars">
        @for (var i = 0; i < Model.ChartLabels.Count; i++)
        {
            var value = Model.ChartValues[i];
            var height = Math.Max(4, value * 100 / maxChartValue);
            <div class="chart-bar-wrap">
                <strong class="small text-dark">@value</strong>
                <div class="chart-bar" style="height:@height%"></div>
                <span class="small text-muted">@Model.ChartLabels[i]</span>
            </div>
        }
    </div>
</div>

<div class="content-card">
    <div class="p-4 border-bottom">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm kiếm theo nội dung, tên hoặc email người đăng..." />
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-dark" type="submit">
                    <i class="fas fa-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Bài viết</th>
                    <th>Người đăng</th>
                    <th>Tương tác</th>
                    <th>Báo cáo</th>
                    <th>Ngày đăng</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Posts.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">Không tìm thấy bài viết phù hợp.</td>
                    </tr>
                }
                else
                {
                    @foreach (var post in Model.Posts)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                                    {
                                        <img src="@Url.Content(post.ImageUrl)" class="post-thumb" alt="Ảnh bài viết" />
                                    }
                                    else
                                    {
                                        <div class="post-thumb d-flex align-items-center justify-content-center text-muted">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-semibold post-content-preview">@post.Content</div>
                                        <small class="text-muted">#@post.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@(post.User?.FullName ?? "Người dùng")</div>
                                <small class="text-muted">@post.User?.Email</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@post.Likes.Count thích</span>
                                <span class="badge bg-light text-dark border">@post.Comments.Count bình luận</span>
                            </td>
                            <td>
                                @{
                                    var pending = post.Reports.Count(r => r.Status == "Pending");
                                }
                                <span class="badge @(pending > 0 ? "bg-danger" : "bg-secondary")">@pending chờ</span>
                            </td>
                            <td class="text-muted">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <form asp-action="DeleteViolation" asp-route-id="@post.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa bài viết vi phạm này?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>