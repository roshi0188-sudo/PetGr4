@using Microsoft.EntityFrameworkCore
@using PetSocial.Data
@inject ApplicationDbContext DbContext

@{
    var pendingReportCount = 0;

    try
    {
        pendingReportCount = await DbContext.PostReports.CountAsync(r => r.Status == "Pending");
    }
    catch
    {
        pendingReportCount = 0;
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị viên PetSocial</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --admin-content-max: 1300px;
            --admin-card-radius: 24px;
            --admin-card-border: #eef1f5;
            --admin-card-shadow: 0 10px 30px rgba(21, 28, 39, .03);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #fff8f2;
        }

        .admin-shell .app-header {
            grid-column: 1 / -1;
        }

        .admin-shell .pet-sidebar {
            top: 18px;
        }

        .admin-main {
            grid-column: 2;
            grid-row: 2;
            display: block;
            min-width: 0;
            width: 100%;
            min-height: calc(100vh - 82px);
            padding: 34px clamp(18px, 3vw, 44px) 0;
            background: #fffaf6;
            position: relative;
            z-index: 1;
        }

        .admin-main > main {
            max-width: var(--admin-content-max);
            margin: 0 auto;
            width: 100%;
        }

        .admin-main .admin-feed-page,
        .admin-main .admin-detail-page,
        .admin-main .admin-reports-page,
        .admin-main .admin-dashboard-page {
            max-width: var(--admin-content-max);
        }

        .admin-shell.sidebar-collapsed .admin-main {
            grid-column: 1 / -1;
        }

        .admin-shell .pet-sidebar-bottom {
            display: flex;
        }

        .admin-sidebar-badge {
            margin-left: auto;
            min-width: 22px;
            height: 22px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 7px;
            background: #fff1f2;
            color: #e11d48;
            font-size: .75rem;
            font-weight: 850;
        }

        .admin-header-notifications {
            position: relative;
        }

        .admin-notification-button {
            position: relative;
            width: 42px;
            height: 42px;
            border: 0;
            outline: none;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #fff4ec;
            color: #ff7e21;
            text-decoration: none;
            box-shadow: none;
            transition: transform .18s ease, background .18s ease, color .18s ease;
        }

        .admin-notification-button:hover {
            background: #ffe7d4;
            color: #e66e1c;
            transform: translateY(-1px);
        }

        .admin-notification-button:focus,
        .admin-notification-button:focus-visible,
        .admin-notification-button:active {
            border: 0;
            outline: none;
            box-shadow: none;
        }

        .admin-notification-button.has-new i {
            animation: adminBellRing 1.15s ease-in-out infinite;
            transform-origin: 50% 0;
        }

        .admin-notification-dot {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #e11d48;
            border: 2px solid #fff;
            box-shadow: 0 0 0 4px rgba(225, 29, 72, .12);
        }

        .admin-footer-note {
            color: #6f625b;
        }

        .admin-main .app-footer-compact {
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .admin-main .app-footer-compact .app-footer-brand-block {
            grid-template-columns: minmax(180px, 220px) minmax(260px, 1fr) minmax(116px, 220px);
            align-items: center;
        }

        .admin-main .app-footer-compact .app-footer-slogan {
            text-align: center;
        }

        .admin-main .app-footer-compact .app-footer-socials {
            justify-content: flex-end;
        }

        @@keyframes adminBellRing {
            0%, 100% { transform: rotate(0deg); }
            15% { transform: rotate(15deg); }
            30% { transform: rotate(-12deg); }
            45% { transform: rotate(9deg); }
            60% { transform: rotate(-6deg); }
            75% { transform: rotate(3deg); }
        }

        @@media (max-width: 900px) {
            .admin-main {
                grid-column: 1;
                grid-row: 3;
                padding: 22px 16px 0;
            }

            .admin-main .app-footer-compact .app-footer-brand-block {
                grid-template-columns: 1fr;
                align-items: flex-start;
            }

            .admin-main .app-footer-compact .app-footer-slogan {
                text-align: left;
            }

            .admin-main .app-footer-compact .app-footer-socials {
                justify-content: flex-start;
            }

            .admin-shell.sidebar-collapsed {
                grid-template-rows: 82px minmax(0, 1fr);
            }
        }
    </style>
</head>
<body>
    <div class="app-shell admin-shell" id="appShell">
        <header class="app-header">
            <div class="app-header-left">
                <button type="button"
                        class="app-header-toggle"
                        data-sidebar-toggle
                        aria-label="Ẩn/hiện thanh danh mục"
                        aria-expanded="true">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="app-header-brand">
                    <span class="app-header-logo">
                        <img src="~/images/logo.jpg" alt="PetGr4" />
                    </span>
                    <span>
                        <strong>PetGr4</strong>
                        <small>Admin</small>
                    </span>
                </a>
            </div>

            <div class="app-header-right">
                <div class="admin-header-notifications">
                    <a class="admin-notification-button @(pendingReportCount > 0 ? "has-new" : "")"
                       asp-area="Admin"
                       asp-controller="Posts"
                       asp-action="Reports"
                       asp-route-status="Pending"
                       aria-label="Thông báo kiểm duyệt">
                        <i class="fa-solid fa-bell"></i>
                        @if (pendingReportCount > 0)
                        {
                            <span class="admin-notification-dot"></span>
                        }
                    </a>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-area=""
                       asp-controller="Profile"
                       asp-action="Index"
                       class="app-header-account">
                        <span class="app-header-avatar">
                            <i class="fa-solid fa-user"></i>
                        </span>
                        <span>
                            <small>Tài khoản</small>
                            <strong>@User.Identity.Name</strong>
                        </span>
                    </a>

                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="app-header-logout-form">
                        <button type="submit" class="app-header-logout" aria-label="Đăng xuất">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </form>
                }
            </div>
        </header>

        <partial name="_Sidebar" />

        <div class="admin-main">
            <main role="main">
                @RenderBody()
            </main>

            <footer class="app-footer app-footer-compact mt-5">
                <div class="container-fluid app-footer-inner">
                    <div class="app-footer-brand-block">
                        <a class="app-footer-logo" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <span class="app-brand-icon">
                                <img src="~/images/logo.jpg" alt="PetGr4" />
                            </span>
                            <span>
                                <strong>PetGr4</strong>
                                <small>Quản trị cộng đồng</small>
                            </span>
                        </a>
                        <p class="app-footer-slogan">Kiểm duyệt nội dung, theo dõi hoạt động và giữ cho cộng đồng yêu thú cưng an toàn hơn.</p>
                        <div class="app-footer-socials">
                            <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                            <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                            <a href="#" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const appShell = document.getElementById('appShell');
            const toggleButton = document.querySelector('[data-sidebar-toggle]');
            if (!appShell || !toggleButton) return;

            const storageKey = 'petsocial.admin.sidebar.collapsed';
            const setCollapsed = (collapsed) => {
                appShell.classList.toggle('sidebar-collapsed', collapsed);
                toggleButton.setAttribute('aria-expanded', (!collapsed).toString());
            };

            setCollapsed(localStorage.getItem(storageKey) === 'true');

            toggleButton.addEventListener('click', () => {
                const collapsed = !appShell.classList.contains('sidebar-collapsed');
                setCollapsed(collapsed);
                localStorage.setItem(storageKey, collapsed.toString());
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
